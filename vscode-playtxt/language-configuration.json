{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{{", "}}"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{{", "close": "}}" },
    { "open": "**", "close": "**" },
    { "open": "\"", "close": "\"" },
    { "open": "„", "close": "”" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["*", "*"],
    ["\"", "\""],
    ["„", "”"],
    ["(", ")"]
  ],
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*(chapter|rozdzia[łl]|act|akt|scene|scena)\\s*:",
      "end": "^\\s*(?=(chapter|rozdzia[łl]|act|akt|scene|scena)\\s*:)"
    }
  },
  "wordPattern": "[\\p{L}\\p{N}_\\-]+"
}
