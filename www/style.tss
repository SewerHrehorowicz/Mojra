*
  box-sizing border-box
  margin 0
  padding 0
  border-radius 0 !important

html, body
  width 100%
  height 100%
  background --bg-obsidian
  color --text-primary
  font-family --font-sans, -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif
  -webkit-font-smoothing antialiased
  -moz-osx-font-smoothing grayscale
  overflow hidden
  user-select none

.stage
  position relative
  width 100vw
  height 100vh
  display flex
  flex-direction column
  align-items center
  justify-content center
  padding 24px
  background-color --bg-obsidian
  background-image radial-gradient(circle at 50% 48%, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.88) 72%, rgba(0, 0, 0, 1) 92%), linear-gradient(to right, #151515 1px, transparent 1px), linear-gradient(to bottom, #151515 1px, transparent 1px)
  background-size 100% 100%, 24px 24px, 24px 24px
  background-position center center

.loom-canvas
  position absolute
  inset 0
  width 100%
  height 100%
  pointer-events none
  z-index 1

.hero
  position relative
  z-index 2
  display flex
  flex-direction column
  align-items center
  text-align center
  transform translateY(-12px)
  transition opacity 0.28s ease, transform 0.28s ease

body.wasm-open .hero, body.beta-open .hero
  opacity 0
  pointer-events none
  transform translateY(-22px) scale(0.985)

.brand-lockup
  display inline-flex
  align-items center
  justify-content center
  margin-bottom 30px

.brand-logo-svg
  width 244px
  height 66px
  display block
  color --text-primary

.brand-subtitle
  font-family --font-sans, sans-serif
  font-size 11px
  font-weight 500
  letter-spacing 4.4px
  color #787878
  text-transform uppercase
  margin-bottom 34px

.brand-subtitle .plus
  color #3d3d3d
  margin 0 8px

.hero-divider
  width 36px
  height 1px
  background --border-subtle
  margin-bottom 32px

.tagline
  font-family --font-serif, Georgia, "Times New Roman", serif
  font-size 25px
  font-weight 400
  letter-spacing 0.4px
  line-height 1.35
  color --text-primary
  margin-bottom 14px

.description
  font-family --font-sans, sans-serif
  font-size 14.5px
  font-weight 300
  letter-spacing 0.4px
  line-height 1.75
  color #808080
  margin-bottom 2px
  max-width 640px

@keyframes playbook-idle-pulse
  0%, 58%, 100%
    transform scale(1)
    filter drop-shadow(0 0 0 rgba(255, 255, 255, 0))
    opacity 0.88
  70%
    transform scale(1.08)
    filter drop-shadow(0 0 14px rgba(255, 255, 255, 0.38))
    opacity 1
  79%
    transform scale(1.02)
    filter drop-shadow(0 0 6px rgba(255, 255, 255, 0.16))
    opacity 0.94
  88%
    transform scale(1.06)
    filter drop-shadow(0 0 11px rgba(255, 255, 255, 0.28))
    opacity 1

.playbook-trigger
  appearance none
  background transparent
  border none
  padding 8px
  margin-top 42px
  margin-bottom 36px
  cursor pointer
  color --text-primary
  display inline-flex
  align-items center
  justify-content center
  animation playbook-idle-pulse 4.2s cubic-bezier(0.22, 1, 0.36, 1) infinite
  transition transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), filter 0.22s ease, opacity 0.22s ease

.playbook-trigger svg
  width 64px
  height 64px
  display block

.playbook-trigger:hover
  animation none
  opacity 1
  transform translateY(-2px) scale(1.06)
  filter drop-shadow(0 0 14px rgba(255, 255, 255, 0.36))

.playbook-trigger:active
  transform translateY(0) scale(0.96)

.playbook-trigger:focus-visible
  outline 1px solid --border-strong
  outline-offset 6px

.beta-trigger
  position relative
  appearance none
  background transparent
  border none
  padding 10px 20px
  font-family --font-sans, sans-serif
  font-size 10px
  font-weight 600
  letter-spacing 2.8px
  color #888888
  cursor pointer
  transition color 0.2s ease, background 0.2s ease

.beta-trigger .dot
  color #383838
  margin 0 8px

.beta-trigger .accent
  color --text-primary

.beta-trigger::before, .beta-trigger::after, .beta-trigger span.corners::before, .beta-trigger span.corners::after
  content ""
  position absolute
  width 6px
  height 6px
  border-color #484848
  border-style solid
  transition border-color 0.2s ease, width 0.2s ease, height 0.2s ease

.beta-trigger::before
  top 0
  left 0
  border-width 1px 0 0 1px

.beta-trigger::after
  top 0
  right 0
  border-width 1px 1px 0 0

.beta-trigger span.corners::before
  bottom 0
  left 0
  border-width 0 0 1px 1px

.beta-trigger span.corners::after
  bottom 0
  right 0
  border-width 0 1px 1px 0

.beta-trigger:hover
  color --text-primary
  background rgba(255, 255, 255, 0.03)

.beta-trigger:hover::before, .beta-trigger:hover::after, .beta-trigger:hover span.corners::before, .beta-trigger:hover span.corners::after
  border-color --text-primary
  width 8px
  height 8px

.status-footer
  position fixed
  bottom 42px
  left 50%
  transform translateX(-50%)
  z-index 2
  padding 10px 22px
  font-size 10px
  font-weight 600
  letter-spacing 3.2px
  color #555555
  white-space nowrap
  pointer-events none

.status-footer::before, .status-footer::after, .status-footer span.corners::before, .status-footer span.corners::after
  content ""
  position absolute
  width 6px
  height 6px
  border-color #383838
  border-style solid

.status-footer::before
  top 0
  left 0
  border-width 1px 0 0 1px

.status-footer::after
  top 0
  right 0
  border-width 1px 1px 0 0

.status-footer span.corners::before
  bottom 0
  left 0
  border-width 0 0 1px 1px

.status-footer span.corners::after
  bottom 0
  right 0
  border-width 0 1px 1px 0

.status-footer .dot
  color #303030
  margin 0 8px

.status-footer .soon
  color #a8a8a8

.footer-investor-link
  color #888888
  text-decoration none
  pointer-events auto
  transition color 0.18s ease

.footer-investor-link:hover
  color --text-primary

.wasm-overlay, .beta-overlay
  position fixed
  inset 0
  display flex
  align-items center
  justify-content center
  padding 48px
  background rgba(0, 0, 0, 0.88)
  opacity 0
  pointer-events none
  transition opacity 0.25s ease
  z-index 50

body.wasm-open .wasm-overlay, body.beta-open .beta-overlay
  opacity 1
  pointer-events auto

.wasm-window
  width min(1080px, 100%)
  height min(680px, calc(100vh - 120px))
  background --bg-obsidian
  border 1px solid --border-subtle
  display grid
  grid-template-rows 36px 1fr

.wasm-topbar, .beta-header
  display flex
  align-items center
  justify-content space-between
  padding 0 12px
  height 36px
  border-bottom 1px solid --border-subtle
  background #050505

.wasm-topbar-left, .beta-header-left
  display flex
  align-items center
  gap 8px
  font-size 10.5px
  font-weight 600
  letter-spacing 1.8px
  color #888888

.wasm-topbar-left svg, .beta-header-left svg
  width 15px
  height 15px
  color --text-primary

.wasm-close-btn
  appearance none
  background transparent
  border none
  color #808080
  width 24px
  height 24px
  display inline-flex
  align-items center
  justify-content center
  cursor pointer

.wasm-close-btn:hover
  color --text-primary

.wasm-close-btn svg
  width 15px
  height 15px

.wasm-viewport
  position relative
  display grid
  grid-template-rows 1fr
  grid-template-columns 100%
  width 100%
  height 100%
  min-width 0
  min-height 0
  overflow hidden
  padding 0
  text-align left
  background --bg-obsidian

.wasm-viewport .workspace, .wasm-viewport .modals-root
  grid-row 1
  grid-column 1
  width 100%
  height 100%
  min-width 0
  min-height 0

.beta-modal
  width min(460px, 100%)
  background --bg-obsidian
  border 1px solid --border-subtle
  user-select text

.beta-form
  display flex
  flex-direction column
  gap 24px
  padding 28px 24px 24px

.beta-intro
  font-family --font-serif, Georgia, serif
  font-size 15px
  line-height 1.5
  color #d0d0d0

.beta-field
  display flex
  flex-direction column
  gap 8px

.beta-label
  font-size 9.5px
  font-weight 700
  letter-spacing 2px
  color #787878

.beta-input, .beta-textarea
  width 100%
  background transparent
  border none
  border-bottom 1px solid --border-strong
  padding 8px 0
  color --text-primary
  font-family --font-sans, sans-serif
  font-size 14px
  line-height 1.5
  outline none
  transition border-color 0.18s ease

.beta-input::placeholder, .beta-textarea::placeholder
  color #444444

.beta-input:focus, .beta-textarea:focus
  border-bottom-color --text-primary

.beta-textarea
  overflow hidden !important
  resize none !important
  min-height 34px

.beta-rodo
  font-size 11px
  line-height 1.5
  color #5c5c5c

.beta-actions
  display flex
  justify-content flex-end
  padding-top 4px

.beta-submit
  position relative
  appearance none
  background transparent
  border none
  padding 10px 22px
  font-family --font-sans, sans-serif
  font-size 10.5px
  font-weight 700
  letter-spacing 2.4px
  color --text-primary
  cursor pointer
  transition background 0.2s ease

.beta-submit::before, .beta-submit::after, .beta-submit span.corners::before, .beta-submit span.corners::after
  content ""
  position absolute
  width 6px
  height 6px
  border-color --text-primary
  border-style solid

.beta-submit::before
  top 0
  left 0
  border-width 1px 0 0 1px

.beta-submit::after
  top 0
  right 0
  border-width 1px 1px 0 0

.beta-submit span.corners::before
  bottom 0
  left 0
  border-width 0 0 1px 1px

.beta-submit span.corners::after
  bottom 0
  right 0
  border-width 0 1px 1px 0

.beta-submit:hover
  background rgba(255, 255, 255, 0.06)

body.pitch-page
  overflow-x hidden
  overflow-y auto
  user-select text
  background-color --bg-obsidian
  background-image radial-gradient(circle at 50% 30%, light-dark(rgba(255, 255, 255, 0), rgba(0, 0, 0, 0)) 0%, light-dark(rgba(255, 255, 255, 0.45), rgba(0, 0, 0, 0.45)) 48%, light-dark(rgba(255, 255, 255, 0.92), rgba(0, 0, 0, 0.92)) 82%), linear-gradient(to right, light-dark(#ececec, #141414) 1px, transparent 1px), linear-gradient(to bottom, light-dark(#ececec, #141414) 1px, transparent 1px)
  background-size 100% 100%, 24px 24px, 24px 24px
  background-attachment fixed

body.pitch-page .loom-canvas
  position fixed
  opacity 0.55

.pitch-topbar
  position sticky
  top 0
  z-index 10
  display grid
  grid-template-columns 1fr auto 1fr
  align-items center
  padding 18px 48px
  background light-dark(rgba(255, 255, 255, 0.88), rgba(0, 0, 0, 0.82))
  border-bottom 1px solid --border-subtle

.pitch-back
  justify-self start
  font-size 10.5px
  font-weight 600
  letter-spacing 2.4px
  color --text-muted
  text-decoration none
  transition color 0.18s ease

.pitch-back:hover
  color --text-primary

.pitch-topbar-logo
  justify-self center
  width 128px
  height 34px
  color --text-primary

.pitch-cta-top
  justify-self end
  position relative
  padding 8px 16px
  font-size 10px
  font-weight 600
  letter-spacing 2.2px
  color --text-primary
  text-decoration none

.pitch-cta-top::before, .pitch-cta-top::after, .pitch-cta-top span.corners::before, .pitch-cta-top span.corners::after
  content ""
  position absolute
  width 5px
  height 5px
  border-color --border-strong
  border-style solid

.pitch-cta-top::before
  top 0
  left 0
  border-width 1px 0 0 1px

.pitch-cta-top::after
  top 0
  right 0
  border-width 1px 1px 0 0

.pitch-cta-top span.corners::before
  bottom 0
  left 0
  border-width 0 0 1px 1px

.pitch-cta-top span.corners::after
  bottom 0
  right 0
  border-width 0 1px 1px 0

.pitch-cta-top:hover
  background light-dark(rgba(0, 0, 0, 0.04), rgba(255, 255, 255, 0.04))

.pitch-container
  position relative
  z-index 2
  max-width 960px
  margin 0 auto
  padding 96px 24px 128px

.pitch-hero
  display flex
  flex-direction column
  align-items center
  text-align center
  margin-bottom 96px

.pitch-title
  font-family --font-serif, Georgia, serif
  font-size 34px
  font-weight 400
  line-height 1.3
  letter-spacing 0.3px
  color --text-primary
  margin-bottom 12px
  max-width 820px

.pitch-subtitle
  font-family --font-serif, Georgia, serif
  font-size 22px
  font-weight 400
  line-height 1.4
  color --text-muted
  margin-bottom 32px
  max-width 740px

.pitch-lead
  font-size 15.5px
  font-weight 300
  line-height 1.75
  color --text-secondary
  max-width 640px
  margin-bottom 64px

.pitch-kpi-strip
  width 100%
  text-align left
  display grid
  grid-template-columns repeat(4, 1fr)
  border-top 1px solid --border-subtle
  border-bottom 1px solid --border-subtle

.pitch-section .pitch-kpi-strip
  margin-bottom 40px

.pitch-kpi-cell
  display flex
  flex-direction column
  gap 10px
  padding 28px 20px
  border-right 1px solid --border-subtle

.pitch-kpi-cell:first-child
  padding-left 0

.pitch-kpi-cell:last-child
  border-right none

.pitch-kpi-val
  font-family --font-serif
  font-size 32px
  font-weight 400
  line-height 1
  color --text-primary

.pitch-kpi-lbl
  font-family --font-sans
  font-size 9.5px
  font-weight 700
  letter-spacing 1.6px
  color --text-muted

.pitch-section
  margin-bottom 96px
  padding-top 48px
  border-top 1px solid --border-subtle

.pitch-section-header
  display flex
  flex-direction column
  gap 18px
  margin-bottom 48px
  max-width 720px

.pitch-num
  font-family --font-sans
  font-size 10px
  font-weight 700
  letter-spacing 2.2px
  color --text-muted

.pitch-heading
  font-family --font-serif
  font-size 28px
  font-weight 400
  line-height 1.32
  color --text-primary

.pitch-text
  font-size 15px
  font-weight 300
  line-height 1.8
  color --text-secondary

.pitch-charts-grid
  display grid
  grid-template-columns 1fr 1fr
  gap 48px

.pitch-chart-box
  display flex
  flex-direction column
  gap 20px
  padding-top 20px
  border-top 1px solid --border-subtle

.pitch-chart-title
  font-family --font-sans
  font-size 9.5px
  font-weight 700
  letter-spacing 1.8px
  color --text-muted

.pitch-bars
  display flex
  flex-direction column
  gap 14px

.pitch-bar-row
  display grid
  grid-template-columns 64px 1fr 72px
  align-items center
  gap 14px

.pitch-bar-label
  font-family --font-sans
  font-size 11px
  font-weight 400
  color --text-muted

.pitch-bar-label-wide
  font-size 12.5px
  font-weight 400
  color --text-secondary

.pitch-charts-grid:last-child .pitch-bar-row, .pitch-bar-row:has(.pitch-bar-label-wide)
  grid-template-columns 168px 1fr 86px

.pitch-bar-track
  width 100%
  height 8px
  background --toggle-track
  position relative

.pitch-bar-fill
  height 100%
  background --toggle-thumb-off

.pitch-bar-fill.hi
  background --text-primary

.pitch-bar-fill.w-4
  width 4%

.pitch-bar-fill.w-6
  width 6%

.pitch-bar-fill.w-12
  width 12%

.pitch-bar-fill.w-14
  width 14%

.pitch-bar-fill.w-16
  width 16%

.pitch-bar-fill.w-20
  width 20%

.pitch-bar-fill.w-24
  width 24%

.pitch-bar-fill.w-28
  width 28%

.pitch-bar-fill.w-30
  width 30%

.pitch-bar-fill.w-32
  width 32%

.pitch-bar-fill.w-33
  width 33%

.pitch-bar-fill.w-35
  width 35%

.pitch-bar-fill.w-40
  width 40%

.pitch-bar-fill.w-44
  width 44%

.pitch-bar-fill.w-47
  width 47%

.pitch-bar-fill.w-56
  width 56%

.pitch-bar-fill.w-65
  width 65%

.pitch-bar-fill.w-68
  width 68%

.pitch-bar-fill.w-85
  width 85%

.pitch-bar-fill.w-88
  width 88%

.pitch-bar-fill.w-90
  width 90%

.pitch-bar-fill.w-94
  width 94%

.pitch-bar-fill.w-96
  width 96%

.pitch-bar-fill.w-100
  width 100%

.pitch-bar-value
  font-family --font-sans
  font-size 11.5px
  font-weight 700
  color --text-primary
  text-align right

.pitch-split-bar
  display flex
  width 100%
  height 32px
  gap 2px

.pitch-split-seg
  display flex
  align-items center
  padding 0 12px
  font-family --font-sans
  font-size 9.5px
  font-weight 700
  letter-spacing 1.4px

.pitch-split-seg.audio
  width 51%
  background --text-primary
  color --accent-fg-inverted

.pitch-split-seg.ebook
  width 49%
  background --toggle-track
  color --text-secondary

.pitch-chart-note
  font-size 13px
  font-weight 300
  line-height 1.7
  color --text-muted

.pitch-diagram-wrap
  display grid
  grid-template-columns 236px 180px 1fr
  align-items center
  padding 28px 0
  border-top 1px solid --border-subtle
  border-bottom 1px solid --border-subtle

.pitch-diag-left
  position relative
  padding-left 22px
  border-left 1px solid --border-subtle
  display flex
  flex-direction column
  gap 6px

.pitch-diag-left::before
  content ""
  position absolute
  left -4px
  top 50%
  transform translateY(-50%)
  width 7px
  height 7px
  background --text-primary

.pitch-diag-kicker
  font-family --font-sans
  font-size 9.5px
  font-weight 700
  letter-spacing 2px
  color --text-muted

.pitch-diag-source
  font-family --font-serif
  font-size 20px
  font-weight 400
  color --text-primary

.pitch-diag-sub
  font-family --font-sans
  font-size 12.5px
  font-weight 300
  color --text-muted

.pitch-diagram-svg
  width 180px
  height 220px
  display block
  color --text-primary

.pitch-diag-right
  display grid
  grid-template-rows repeat(4, 55px)
  padding-left 16px

.pitch-diag-row
  display flex
  align-items center
  justify-content space-between
  gap 16px

.pitch-diag-target
  font-family --font-serif
  font-size 15px
  font-weight 400
  color --text-primary

.pitch-diag-tag
  font-family --font-sans
  font-size 9.5px
  font-weight 700
  letter-spacing 1.8px
  color --text-muted
  white-space nowrap

.pitch-footer-cta
  display flex
  flex-direction column
  align-items center
  text-align center
  gap 16px
  padding 64px 24px
  border-top 1px solid --border-subtle
  border-bottom 1px solid --border-subtle

.pitch-cta-headline
  font-family --font-serif, Georgia, serif
  font-size 26px
  color --text-primary

.pitch-cta-sub
  font-size 14.5px
  font-weight 300
  color --text-muted
  margin-bottom 14px

.pitch-footer-cta .beta-submit
  text-decoration none
  display inline-block

.pitch-sources
  margin-top 64px
  padding-top 28px
  border-top 1px solid --border-subtle

.pitch-sources-title
  font-family --font-sans
  font-size 9.5px
  font-weight 700
  letter-spacing 2px
  color --text-muted
  margin-bottom 14px

.pitch-sources-list
  display flex
  flex-direction column
  gap 8px

.pitch-source-item
  font-size 11.5px
  font-weight 300
  line-height 1.5
  color --text-muted
  text-decoration none
  transition color 0.18s ease

.pitch-source-item:hover
  color --text-primary

.cite-ref
  color --text-muted
  text-decoration none
  font-family --font-sans
  font-weight 700
  font-size 0.85em
  margin-left 2px
  transition color 0.18s ease

.cite-ref:hover
  color --text-primary
  text-decoration underline

html:has(body.deck-page), body.deck-page
  color-scheme light
  --bg-obsidian #ffffff
  --bg-surface #ffffff
  background-image none !important
  background-color #ffffff !important
  background #ffffff !important

body.deck-page .pitch-topbar
  position relative
  overflow hidden
  width 100%
  max-width 100%
  height 204px
  margin 0 auto 18px
  padding 36px 48px 16px
  border-bottom none
  background transparent
  align-items flex-start

.deck-header-loom
  position absolute
  inset 0
  width 100%
  height 100%
  pointer-events none
  z-index 0

body.deck-page .pitch-back, body.deck-page .pitch-cta-top
  position relative
  z-index 2
  margin-top 8px

.deck-brand-hero
  position relative
  z-index 2
  justify-self center
  display flex
  flex-direction column
  align-items center
  text-align center

body.deck-page .brand-lockup
  margin-bottom 20px

body.deck-page .brand-logo-svg
  width 198px
  height 54px
  color #000000

body.deck-page .brand-subtitle
  font-size 9.5px
  font-weight 500
  letter-spacing 4.2px
  color #707070
  margin-bottom 22px

body.deck-page .brand-subtitle .plus
  color #a8a8a8
  margin 0 8px

body.deck-page .hero-divider
  width 36px
  height 1px
  background #cccccc
  margin-bottom 0

body.deck-page .pitch-container
  max-width 680px
  margin 0 auto
  padding 8px 0 64px

body.deck-page .pitch-hero
  align-items flex-start
  text-align left
  gap 0
  margin-bottom 42px

body.deck-page .pitch-hero .pitch-num
  margin-bottom 8px

body.deck-page .pitch-title
  font-size 16.5px
  line-height 1.34
  letter-spacing 0.1px
  margin-bottom 12px
  max-width 100%
  text-wrap pretty

body.deck-page .pitch-lead, body.deck-page .pitch-text
  font-size 10.5px
  font-weight 400
  line-height 1.46
  color #333333
  max-width 100%
  margin-bottom 0
  text-wrap pretty

body.deck-page .pitch-lead
  margin-bottom 22px

body.deck-page .pitch-kpi-strip
  background transparent
  border-top 1px solid #111111
  border-bottom 1px solid #dcdcdc
  margin-top 0

body.deck-page .pitch-kpi-cell
  gap 5px
  padding 16px 18px
  border-right 1px solid #e8e8e8

body.deck-page .pitch-kpi-cell:first-child
  padding-left 0

body.deck-page .pitch-kpi-cell:last-child
  border-right none
  padding-right 0

body.deck-page .pitch-kpi-val
  font-size 17px
  font-weight 400
  letter-spacing 0.1px

body.deck-page .pitch-kpi-lbl
  font-size 7.5px
  font-weight 600
  letter-spacing 1.2px
  line-height 1.35
  color #686868

body.deck-page .pitch-section
  position relative
  margin-bottom 42px
  padding-top 34px
  border-top none

body.deck-page .pitch-section::before
  content ""
  position absolute
  top 0
  left 0
  width 36px
  height 1px
  background #999999

body.deck-page .pitch-section-header
  gap 0
  margin-bottom 22px
  max-width 100%

body.deck-page .pitch-section-header .pitch-num
  margin-bottom 6px

body.deck-page .pitch-num
  font-size 8px
  font-weight 600
  letter-spacing 2.2px
  color #707070

body.deck-page .pitch-heading
  font-size 14.5px
  line-height 1.32
  letter-spacing 0.1px
  margin-bottom 10px
  text-wrap pretty

body.deck-page .pitch-charts-grid
  gap 40px

body.deck-page .pitch-chart-box
  gap 14px
  padding-top 12px
  border-top 1px solid #cccccc

body.deck-page .pitch-chart-title
  font-size 7.5px
  font-weight 700
  letter-spacing 1.5px
  color #555555

body.deck-page .pitch-bars
  gap 12px

body.deck-page .pitch-bar-row, body.deck-page .pitch-bar-row:has(.pitch-bar-label-wide), body.deck-page .pitch-charts-grid:last-child .pitch-bar-row
  display grid
  grid-template-columns 1fr auto
  row-gap 5px
  column-gap 12px
  align-items baseline

body.deck-page .pitch-bar-label, body.deck-page .pitch-bar-label-wide
  grid-column 1
  grid-row 1
  font-size 10px
  font-weight 400
  line-height 1.25
  color #222222

body.deck-page .pitch-bar-value
  grid-column 2
  grid-row 1
  font-size 10px
  font-weight 700
  line-height 1.25
  color #000000

body.deck-page .pitch-bar-track
  grid-column 1 / -1
  grid-row 2
  height 5px
  background #ececec

body.deck-page .pitch-bar-fill
  background #a8a8a8

body.deck-page .pitch-bar-fill.hi
  background #111111

body.deck-page .pitch-sources
  position relative
  margin-top 36px
  padding-top 22px
  border-top none

body.deck-page .pitch-sources::before
  content ""
  position absolute
  top 0
  left 0
  width 36px
  height 1px
  background #999999

body.deck-page .pitch-sources-title
  font-size 7.5px
  letter-spacing 2px
  margin-bottom 6px
  color #707070

body.deck-page .pitch-sources-list
  gap 4px

body.deck-page .pitch-source-item
  font-size 8.5px
  font-weight 400
  line-height 1.4
  color #666666

body.deck-page .pitch-section.first-on-sheet
  padding-top 0

body.deck-page .pitch-section.first-on-sheet::before
  display none

.deck-sheet
  display flex
  flex-direction column
  justify-content space-between

.deck-page-footer
  display grid
  grid-template-columns 1fr auto 1fr
  align-items center
  padding-top 14px
  margin-top 40px
  border-top 1px solid #e0e0e0
  font-family --font-sans
  font-size 7.5px
  font-weight 600
  letter-spacing 1.8px
  color #787878

.deck-footer-left
  justify-self start

.deck-footer-center
  justify-self center

.deck-footer-right
  justify-self end
  color #222222

// Detailed Cost & Bottom-Up Tables (deck.tpl)
.deck-cost-grid
  display grid
  grid-template-columns 1fr 1fr
  gap 32px

.deck-cost-col
  display flex
  flex-direction column
  gap 8px
  padding-top 10px
  border-top 1px solid #111111

.deck-cost-list
  display flex
  flex-direction column

.deck-cost-item
  display grid
  grid-template-columns 1fr auto
  align-items baseline
  gap 10px
  padding 6px 0
  border-bottom 1px solid #ececec

.deck-cost-item:last-child
  border-bottom none

.deck-cost-item.total-row
  border-top 1px solid #111111
  border-bottom none
  padding-top 8px
  margin-top 2px

.deck-cost-name
  font-size 9.5px
  font-weight 400
  line-height 1.35
  color #222222

.deck-cost-item.total-row .deck-cost-name
  font-weight 700
  color #000000

.deck-cost-val
  font-size 9.5px
  font-weight 700
  color #000000
  white-space nowrap

.deck-mech-list
  display flex
  flex-direction column
  border-top 1px solid #111111

.deck-mech-row
  display grid
  grid-template-columns 152px 1fr 116px
  gap 18px
  align-items baseline
  padding 11px 0
  border-bottom 1px solid #e6e6e6

.deck-mech-row:last-child
  border-bottom none

.deck-mech-left
  display flex
  flex-direction column
  gap 2px

.deck-mech-source
  font-family --font-serif
  font-size 11.5px
  font-weight 400
  color #000000

.deck-mech-tag
  font-family --font-sans
  font-size 7.5px
  font-weight 700
  letter-spacing 1.2px
  color #707070

.deck-mech-how
  font-size 9.5px
  font-weight 400
  line-height 1.42
  color #2b2b2b

.deck-mech-amt
  font-family --font-serif
  font-size 13px
  font-weight 400
  color #000000
  text-align right
  white-space nowrap

.deck-math-table
  width 100%
  display flex
  flex-direction column
  border-top 1px solid #111111
  border-bottom 1px solid #111111

.deck-math-hdr
  display grid
  grid-template-columns 148px 1fr 1fr 1fr
  gap 14px
  padding 8px 0
  border-bottom 1px solid #cccccc
  font-family --font-sans
  font-size 7.5px
  font-weight 700
  letter-spacing 1.3px
  color #555555

.deck-math-row
  display grid
  grid-template-columns 148px 1fr 1fr 1fr
  gap 14px
  align-items baseline
  padding 8px 0
  border-bottom 1px solid #eeeeee
  font-size 9px
  line-height 1.35
  color #222222

.deck-math-row.summary
  border-top 1px solid #cccccc
  border-bottom none
  background #f9f9f9
  font-weight 700
  color #000000
  padding 9px 4px

.deck-math-label
  font-weight 600
  color #111111

.deck-math-cell
  display flex
  flex-direction column
  gap 2px

.deck-math-eq
  font-size 8.5px
  color #666666

.deck-math-val
  font-size 10px
  font-weight 700
  color #000000

// 36-Month Simulation Table (przeglad.tpl)
.sim-month-table
  width 100%
  display flex
  flex-direction column
  border-top 1px solid #111111
  border-bottom 1px solid #111111
  margin-bottom 14px

.sim-month-hdr
  display grid
  grid-template-columns 34px 1.55fr 0.72fr 0.62fr 0.55fr 0.78fr 0.85fr 0.75fr 0.58fr
  gap 6px
  padding 5px 0
  border-bottom 1px solid #cccccc
  font-family --font-sans
  font-size 6.5px
  font-weight 700
  letter-spacing 0.8px
  color #444444

.sim-month-row
  display grid
  grid-template-columns 34px 1.55fr 0.72fr 0.62fr 0.55fr 0.78fr 0.85fr 0.75fr 0.58fr
  gap 6px
  align-items baseline
  padding 3.5px 0
  border-bottom 1px solid #f0f0f0
  font-size 7.8px
  line-height 1.25
  color #222222

.sim-month-row.summary
  border-top 1px solid #bbbbbb
  border-bottom none
  background #f6f6f6
  font-weight 700
  color #000000
  padding 5px 2px

.sim-m-code
  font-family --font-sans
  font-weight 700
  color #111111

.sim-m-num
  text-align right
  white-space nowrap

.sim-m-hi
  text-align right
  font-weight 700
  color #000000
  white-space nowrap

// 12-Month Gantt Chart & Chronological Timeline (plan.tpl)
.plan-gantt
  width 100%
  display flex
  flex-direction column
  border-top 1px solid #111111
  border-bottom 1px solid #dcdcdc
  margin-top 4px

.plan-gantt-head
  display grid
  grid-template-columns 232px repeat(4, 1fr)
  align-items center
  padding 8px 0
  border-bottom 1px solid #e0e0e0
  font-family --font-sans
  font-size 7px
  font-weight 700
  letter-spacing 1.1px
  color #666666

.plan-gantt-task-hdr
  padding-right 12px

.plan-gantt-q
  padding-left 8px
  border-left 1px solid #eaeaea
  white-space nowrap

.plan-gantt-row
  display grid
  grid-template-columns 232px 1fr
  align-items center
  padding 7px 0
  border-bottom 1px solid #f0f0f0

.plan-gantt-row:last-child
  border-bottom none

.plan-gantt-label
  font-size 9.5px
  font-weight 400
  color #222222
  padding-right 12px

.plan-gantt-track
  position relative
  height 6px
  background-color #f2f2f2
  background-image linear-gradient(to right, #e2e2e2 1px, transparent 1px)
  background-size 25% 100%

.plan-gantt-bar
  position absolute
  top 0
  bottom 0
  background #111111

.plan-gantt-bar.g-m1-1
  left 0%
  width 9%

.plan-gantt-bar.g-m1-2
  left 3%
  width 16%

.plan-gantt-bar.g-m2-4
  left 10%
  width 24%

.plan-gantt-bar.g-m3-4
  left 18%
  width 18%

.plan-gantt-bar.g-m5-9
  left 33%
  width 42%

.plan-gantt-bar.g-m5-10
  left 33%
  width 50%

.plan-gantt-bar.g-m8-12
  left 60%
  width 40%

.plan-timeline
  display flex
  flex-direction column
  border-top 1px solid #dcdcdc

.plan-tl-item
  display grid
  grid-template-columns 148px 1fr
  gap 24px
  padding 14px 0
  border-bottom 1px solid #ebebeb

.plan-tl-item:last-child
  border-bottom none

.plan-tl-left
  position relative
  padding-left 18px
  display flex
  flex-direction column
  gap 3px

.plan-tl-dot
  position absolute
  left 0
  top 3px
  width 7px
  height 7px
  border-radius 50% !important

.plan-tl-dot.solid
  background #111111

.plan-tl-dot.hollow
  background #ffffff
  border 1.5px solid #111111

.plan-tl-period
  font-family --font-sans
  font-size 9px
  font-weight 700
  letter-spacing 1.2px
  color #111111

.plan-tl-tag
  font-family --font-sans
  font-size 7.5px
  font-weight 600
  letter-spacing 1.4px
  color #787878

.plan-tl-right
  display flex
  flex-direction column
  gap 4px

.plan-tl-title
  font-family --font-serif
  font-size 12.5px
  font-weight 400
  line-height 1.3
  color #000000

.plan-tl-desc
  font-size 10px
  font-weight 400
  line-height 1.45
  color #333333

@page
  size A4 portrait
  margin 15mm 18mm

@page :first
  margin-top 0

@media print
  :root, html, body, body.pitch-page, body.deck-page
    color-scheme light !important
    --bg-obsidian #ffffff !important
    --bg-surface #ffffff !important
    height auto
    overflow visible
    background-color #ffffff !important
    background-image none !important
    background #ffffff !important
    -webkit-print-color-adjust exact
    print-color-adjust exact
  body.pitch-page
    zoom 1
  .loom-canvas, .pitch-back, .pitch-cta-top, .pitch-footer-cta
    display none !important
  body.deck-page .pitch-topbar
    position relative
    display flex
    justify-content center
    align-items flex-start
    width calc(100% + 36mm)
    max-width none
    height 228px
    margin 0 -18mm 28px -18mm
    padding 56px 18mm 0
    background transparent
    border-bottom none
  body.deck-page .pitch-container
    max-width 100%
    margin 0 auto
    padding 0 8px
  .deck-sheet.sheet-1
    min-height 214mm
  .deck-sheet.sheet-2, .deck-sheet.sheet-3
    min-height 264mm
    break-before page
    padding-top 8px
  .deck-page-footer
    margin-top auto
    padding-top 12px
  body.deck-page .pitch-hero
    margin-bottom 48px
  body.deck-page .pitch-section
    margin-bottom 48px
    padding-top 38px
    break-inside avoid
  body.deck-page .pitch-section.first-on-sheet
    padding-top 0
  body.deck-page .pitch-section-header
    margin-bottom 24px
  body.deck-page .pitch-sources
    margin-top 40px
    padding-top 24px
    break-inside avoid

@media screen and (max-width: 760px)
  .pitch-topbar
    padding 14px 20px
  .pitch-title
    font-size 26px
  .pitch-kpi-strip
    grid-template-columns 1fr 1fr
  .pitch-charts-grid
    grid-template-columns 1fr
    gap 32px
  .pitch-diagram-wrap
    grid-template-columns 1fr
    gap 24px
  .pitch-diagram-svg
    display none

@media screen and (max-width: 640px)
  .brand-logo-svg
    width 196px
    height 53px
  .tagline
    font-size 21px
  .description
    font-size 13.5px
    margin-bottom 36px
  .wasm-overlay, .beta-overlay
    padding 16px
