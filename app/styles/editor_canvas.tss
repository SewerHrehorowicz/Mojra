// Studio Workspace & Top Toolbar
.studio-workspace-full
  display flex
  flex-direction column
  flex 1
  width 100%
  height 100%
  overflow hidden
  background --bg-obsidian

.canvas-toolbar
  padding 0 8px
  height 36px
  min-height 36px
  max-height 36px
  box-sizing border-box
  background --bg-topbar
  border-bottom 1px solid --border-subtle
  display flex
  align-items center
  justify-content space-between
  gap 6px
  flex-shrink 0

.canvas-toolbar-left
  display flex
  align-items center
  gap 4px
  flex 1
  min-width 0

.canvas-toolbar-center
  display flex
  align-items center
  justify-content center
  flex-shrink 0

.canvas-legend
  font-size 11px
  text-transform uppercase
  letter-spacing 0.8px
  color --text-muted
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  margin-right 4px

.canvas-book-title
  color --text-primary
  font-family --font-sans
  font-size 11px
  font-weight 600
  text-transform uppercase
  letter-spacing 0.8px
  max-width 320px
  user-select none

.canvas-selection-badge
  font-family --font-sans
  font-size 10px
  text-transform uppercase
  letter-spacing 0.6px
  padding 3px 8px
  border 1px solid --text-primary
  color --text-primary
  background --bg-elevated
  white-space nowrap

.canvas-toolbar-right
  display flex
  align-items center
  justify-content flex-end
  gap 4px
  flex 1
  min-width 0
  flex-wrap nowrap
  flex-shrink 0

.canvas-history-controls
  display inline-flex
  align-items center
  gap 4px

.canvas-zoom-controls
  display inline-flex
  align-items center
  gap 2px

.canvas-zoom-label
  font-family --font-sans
  font-size 11px
  min-width 38px
  text-align center

.studio-preview-banner
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 8px 18px
  background --bg-elevated
  border-bottom 1px solid --text-primary
  font-family --font-sans
  font-size 11px
  flex-shrink 0

.player-preview-banner
  max-width 680px
  width 100%
  margin 0 auto 12px
  border 1px solid --text-primary

.studio-preview-banner-text
  color --text-primary
  font-weight 600

.studio-preview-banner-actions
  display flex
  align-items center
  gap 6px
  flex-shrink 0

.studio-warnings-banner
  padding 10px 24px
  background --bg-elevated
  border-bottom 1px solid --accent-danger
  font-size 12px
  flex-shrink 0
  max-height 110px
  overflow-y auto

// Contextual Left Panel & Infinite Canvas Split
.editor-workspace-body
  display flex
  flex-direction row
  flex 1
  width 100%
  height 100%
  min-height 0
  overflow hidden
  position relative

// Infinite Canvas, Stage & Wire Layer
.timeline-scroll-viewport
  order 2
  flex 1
  overflow hidden
  position relative
  background-color --bg-obsidian
  cursor default
  touch-action none
  user-select none
  -webkit-user-select none
  -webkit-touch-callout none

.timeline-scroll-viewport *
  touch-action none
  user-select none
  -webkit-user-select none

.timeline-scroll-viewport .custom-select-menu, .timeline-scroll-viewport .custom-select-menu *, .timeline-scroll-viewport .studio-search-results, .timeline-scroll-viewport .studio-search-results *
  touch-action pan-y

.timeline-scroll-viewport input, .timeline-scroll-viewport textarea
  user-select text
  -webkit-user-select text
  cursor text

.timeline-scroll-viewport input::selection, .timeline-scroll-viewport textarea::selection
  background --border-strong
  color --text-primary

.timeline-scroll-viewport ::selection
  background transparent

.timeline-scroll-viewport.is-panning
  cursor grabbing

.studio-canvas
  position absolute
  inset 0
  width 100%
  height 100%
  display block
  pointer-events auto
  z-index 1

.canvas-floating-chapter-input
  position absolute
  z-index 90
  background --bg-elevated
  border none
  border-bottom 1px solid --text-primary
  color --text-primary
  font-family --font-sans
  font-size 11px
  font-weight 700
  text-transform uppercase
  letter-spacing 0.65px
  line-height 1
  font-kerning none
  font-variant-ligatures none
  padding 0
  outline none
  white-space nowrap

.editor-empty-state
  position absolute
  inset 0
  z-index 40
  display flex
  align-items center
  justify-content center
  padding 24px
  pointer-events auto

.editor-empty-card
  max-width 420px
  width 100%
  padding 24px
  background --bg-obsidian
  border 1px solid --border-strong
  display flex
  flex-direction column
  align-items center
  text-align center
  gap 12px

.editor-empty-title
  font-family --font-serif
  font-size 18px
  font-weight 400
  color --text-primary

.editor-empty-desc
  font-size 13px
  line-height 1.5
  color --text-secondary

.editor-empty-actions
  display flex
  flex-wrap wrap
  justify-content center
  gap 10px
  padding-top 6px

// Canvas Context Menu
.canvas-context-menu
  position absolute
  z-index 120
  min-width 210px
  background --bg-obsidian
  border 1px solid --text-primary
  box-shadow 0 6px 18px rgba(0, 0, 0, 0.45)
  display flex
  flex-direction column
  box-shadow switch(theme)
    light 0 2px 8px rgba(0, 0, 0, 0.06)

.canvas-context-item
  width 100%
  background --bg-obsidian
  border none
  border-bottom 1px solid --border-subtle
  color --text-primary
  font-family --font-sans
  font-size 11px
  text-transform uppercase
  letter-spacing 0.6px
  padding 9px 14px
  text-align left
  cursor pointer
  transition background 0.12s ease, color 0.12s ease

.canvas-context-item:last-child
  border-bottom none

.canvas-context-item:hover
  background --bg-elevated
  color --text-primary

.timeline-node-card
  width 192px

.canvas-floating-node-input, .canvas-floating-choice-input
  position absolute
  z-index 95
  background --bg-obsidian
  border none
  border-bottom 1px solid --text-primary
  color --text-primary
  line-height 1
  font-kerning none
  font-variant-ligatures none
  outline none
  padding 0

.canvas-floating-node-input
  font-family --font-serif
  font-size 13px
  font-weight 400
  letter-spacing 0px

.canvas-floating-choice-input
  font-family --font-sans
  font-size 11px
  font-weight 400
  letter-spacing 0px

// Floating Studio Search Palette (#studio-search-palette)
.studio-search-palette
  position absolute
  top 16px
  left 50%
  transform translateX(-50%)
  width min(460px, calc(100% - 32px))
  max-height min(380px, calc(100% - 48px))
  background --bg-panel-solid
  border 1px solid --border-strong
  box-shadow 0 18px 42px --shadow-heavy
  display flex
  flex-direction column
  z-index 130
  pointer-events auto

.studio-search-header
  display flex
  align-items center
  gap 8px
  margin 0 14px
  padding 8px 0 6px
  border-bottom 1px solid --border-strong
  transition border-color 0.15s ease

.studio-search-header:focus-within
  border-bottom-color --text-primary

.studio-search-icon
  width 14px
  height 14px
  color --text-primary
  flex-shrink 0

.studio-search-input
  flex 1
  min-width 0
  background transparent
  border none !important
  outline none
  color --text-primary
  font-family --font-sans
  font-size 13px
  padding 2px 0

.studio-search-input::placeholder
  color --text-muted

.studio-search-count
  font-family --font-sans
  font-size 10px
  color --text-muted
  flex-shrink 0

.studio-search-results
  display flex
  flex-direction column
  overflow-y auto
  max-height 310px

.studio-search-row
  display flex
  flex-direction column
  gap 3px
  padding 9px 14px
  border-bottom 1px solid --border-subtle
  border-left 2px solid transparent
  cursor pointer
  background --bg-obsidian
  transition background 0.12s ease

.studio-search-row:last-child
  border-bottom none

.studio-search-row:hover, .studio-search-row.is-active
  background --bg-elevated

.studio-search-row.is-active
  border-left-color --text-primary

.studio-search-row-top
  display flex
  align-items center
  gap 8px
  min-width 0

.studio-search-row-title
  font-family --font-serif
  font-size 13px
  font-weight 700
  color --text-primary
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.studio-search-row-id
  font-family --font-sans
  font-size 10px
  color --text-muted
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  flex 1
  min-width 0

.studio-search-row-badge
  font-family --font-sans
  font-size 9px
  font-weight 700
  letter-spacing 0.8px
  text-transform uppercase
  color --text-muted
  flex-shrink 0

.studio-search-row.is-active .studio-search-row-badge
  color --text-primary

.studio-search-edit-btn
  width 20px
  height 20px
  display inline-flex
  align-items center
  justify-content center
  background transparent
  border none
  color --text-muted
  cursor pointer
  padding 0
  flex-shrink 0

.studio-search-edit-btn:hover, .studio-search-row.is-active .studio-search-edit-btn
  color --text-primary

.studio-search-row-chapter
  font-family --font-sans
  font-size 9px
  font-weight 700
  letter-spacing 1px
  text-transform uppercase
  color --text-muted

.studio-search-row-snippet
  font-family --font-sans
  font-size 11px
  color --text-secondary
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.studio-search-snip-hit
  color --text-primary
  font-weight 700

body[data-ui-scale="large"]
  .canvas-toolbar
    padding 0 20px
    height 50px
    min-height 50px
    max-height 50px
    box-sizing border-box
    gap 16px

  .canvas-toolbar-right
    gap 18px

  .canvas-zoom-controls
    gap 6px

  .canvas-zoom-label
    font-size 14px
    min-width 48px

  .canvas-context-item
    font-size 13px
    padding 12px 16px

/* @dev-only-start */
.canvas-toolbar
  @switch preview
    portrait
      flex-direction row
      flex-wrap wrap
      align-items center
      justify-content space-between
      height auto
      max-height none
      padding 4px 8px
      gap 4px
    tablet, landscape
      padding 4px 8px
      gap 6px

body[data-ui-scale="large"] .canvas-toolbar
  @switch preview
    portrait
      height auto
      max-height none
      padding 6px 8px
      gap 4px

.canvas-toolbar-left
  @switch preview
    portrait
      width auto
      flex 0 1 auto
      justify-content flex-start
      gap 4px

.canvas-toolbar-left .canvas-legend
  @switch preview
    portrait
      margin-right auto

.canvas-toolbar-right
  @switch preview
    portrait
      width auto
      flex 1 0 auto
      justify-content flex-end
      flex-wrap wrap
      gap 4px
    tablet, landscape
      gap 4px

.canvas-zoom-controls
  @switch preview
    portrait
      gap 2px

.canvas-zoom-label
  @switch preview
    portrait
      min-width 32px
      font-size 10px
      padding 4px 2px
/* @dev-only-end */

@media (max-width: 760px)
  .canvas-toolbar
    flex-direction row
    flex-wrap wrap
    align-items center
    justify-content space-between
    height auto
    max-height none
    padding 4px 8px
    gap 4px

  .canvas-toolbar-left
    width auto
    flex 0 1 auto
    justify-content flex-start
    gap 4px

  .canvas-toolbar-left .canvas-legend
    margin-right auto

  .canvas-toolbar-right
    width auto
    flex 1 0 auto
    justify-content flex-end
    flex-wrap wrap
    gap 4px

  .canvas-zoom-controls
    gap 2px

  .canvas-zoom-label
    min-width 32px
    font-size 10px
    padding 4px 2px

  body[data-ui-scale="large"]
    .canvas-toolbar
      height auto
      max-height none
      padding 6px 8px
      gap 4px

    .canvas-toolbar-right
      gap 4px

    .canvas-zoom-controls
      gap 2px

    .canvas-zoom-label
      min-width 34px
      font-size 11px
      padding 4px 2px
