body[data-ui-scale="large"]
  .modal-backdrop.scene-text-fullscreen-backdrop
    top 50px

  .scene-text-editor-feed .reader-global-meta
    height 42px
    min-height 42px
    max-height 42px

  .scene-text-expand-btn
    width 36px
    height 42px

  .modal-card
    max-width 560px
    padding 28px

  .modal-title
    font-size 23px

  .modal-desc, .field-input, .help-list
    font-size 16px

  .scene-text-back-btn
    width 32px
    height 32px
    font-size 12px

  .incoming-choice-btn
    font-size 16px
    padding 12px 36px

  .incoming-choice-sep, .incoming-choice-label
    font-size 14px

  .incoming-choice-arrow
    font-size 18px

  .scene-text-editor-card .scene-header-block
    padding 0

  .scene-text-editor-card .scene-title-row
    padding 13px 36px

  .modal-choice-nav-btn, .scene-settings-toggle-btn, .scene-preview-mode-btn, .scene-settings-row .node-media-add-btn, .modal-add-choice-btn
    width 32px
    height 32px

  .scene-settings-icon, .scene-star-icon, .scene-settings-row .media-plus-icon, .modal-add-choice-btn .media-plus-icon
    width 18px
    height 18px

  .scene-settings-row .node-meta-key
    font-size 14px
    width 64px

  .scene-settings-row .node-meta-input, .scene-settings-row .custom-select-trigger, .scene-settings-row .syn-inner-input
    height 34px
    font-size 14px

  .scene-settings-row .custom-select-option
    font-size 14px

  .scene-test-vars-popover
    width 336px
    min-width 336px
    max-width 360px

  .test-var-key
    width 144px
    min-width 144px
    max-width 144px
    font-size 13px

  .test-var-bool-btn, .test-var-int-input, .test-var-enum-select .custom-select-trigger, .test-var-enum-select .custom-select-option
    font-size 13px

body[data-ui-scale="zen"]
  .scene-text-editor-feed .reader-global-meta
    display flex !important

  .scene-text-editor-card .scene-header-block
    top 27px
    padding 0
    border-top 1px solid --border-subtle !important
    border-bottom 1px solid --border-subtle !important

  .active-scene-stage > .scene-card.scene-text-editor-card
    border-top none
