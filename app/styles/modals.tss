.scene-text-back-btn
  display inline-flex
  align-items center
  justify-content center
  gap 6px
  width 28px
  height 28px
  padding 0
  border none
  background transparent
  color --text-secondary
  font-family --font-sans
  font-size 10px
  font-weight 600
  text-transform uppercase
  letter-spacing 1px
  line-height 1
  white-space nowrap
  cursor pointer
