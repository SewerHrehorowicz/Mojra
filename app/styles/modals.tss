.modal-backdrop
  position absolute
  inset 0
  pointer-events auto
  background rgba(0, 0, 0, 0.85)
  display flex
  align-items center
  justify-content center
  padding 20px
  z-index 120

#modal-confirm
  z-index 130

.modal-card
  width 100%
  max-width 440px
  background --bg-obsidian
  border 1px solid --border-subtle
  overflow hidden

.modal-card-lg
  max-width 640px

.modal-header
  padding 22px 24px 0
  display flex
  align-items center
  justify-content space-between

.modal-title
  font-family --font-serif
  font-size 19px
  font-weight 400
  color --text-primary

.modal-body
  padding 14px 24px 22px
  display flex
  flex-direction column
  gap 16px

.modal-desc
  font-size 14px
  line-height 1.6
  color --text-secondary

.qr-modal-body
  align-items center
  text-align center

.settings-modal-actions
  display flex
  flex-wrap wrap
  justify-content center
  gap 10px
  width 100%
  padding-bottom 4px

.qr-frame
  padding 14px
  background #ffffff
  display inline-flex

.qr-image
  width 220px
  height 220px
  display block
  image-rendering pixelated

.lan-url-box
  font-family --font-sans
  font-size 13px
  color --text-primary
  padding 4px 0
  user-select all

.form-field
  display flex
  flex-direction column
  gap 6px

.field-label
  font-size 11px
  text-transform uppercase
  letter-spacing 0.8px
  color --text-muted

.field-input
  width 100%
  background --bg-elevated
  border 1px solid --border-subtle
  color --text-primary
  font-family --font-sans
  font-size 14px
  padding 8px 10px

.field-input:focus
  outline none
  border-color --text-primary

.checkbox-field .checkbox-label
  display flex
  align-items flex-start
  gap 8px
  font-size 13px
  line-height 1.45
  color --text-secondary
  cursor pointer

.modal-actions
  padding-top 6px
  display flex
  justify-content flex-end
  gap 10px
  width 100%

.add-book-section
  display flex
  flex-direction column
  gap 8px
  padding-bottom 14px
  border-bottom 1px solid --border-subtle

.add-book-browse-row
  display flex
  align-items center
  gap 8px
  flex-wrap wrap

.add-book-inline-form
  display flex
  align-items stretch
  gap 8px

.add-book-inline-form .field-input
  flex 1

.help-shortcuts-list
  display flex
  flex-direction column
  border-top 1px solid --border-subtle

.help-shortcut-row
  display grid
  grid-template-columns 220px 1fr
  gap 14px
  align-items baseline
  padding 10px 0
  border-bottom 1px solid --border-subtle

.help-shortcut-key
  font-family --font-sans
  font-size 11px
  font-weight 600
  color --text-primary

.help-shortcut-desc
  font-size 13px
  line-height 1.5
  color --text-secondary

.modal-backdrop.scene-text-fullscreen-backdrop
  padding 0
  background --bg-obsidian
  backdrop-filter none
  align-items stretch
  justify-content stretch
  overflow hidden

.scene-text-book-layout
  width 100%
  height 100%
  min-height 0

.scene-text-editor-feed
  height 100%
  min-height 0

.scene-text-editor-feed .reader-global-meta
  display flex
  align-items center
  justify-content space-between
  gap 12px

.scene-text-editor-feed .scene-chapter-pill
  flex 1
  min-width 0

.scene-text-editor-top-bar
  display flex
  align-items center
  height 100%
  gap 8px
  flex-shrink 0

.scene-text-back-btn
  display inline-flex
  align-items center
  gap 6px
  height 100%
  padding 0 2px
  border none
  background transparent
  color --text-secondary
  font-family --font-sans
  font-size 10px
  font-weight 600
  text-transform uppercase
  letter-spacing 1px
  line-height 1
  white-space nowrap
  cursor pointer
  transition color 0.15s ease

.scene-text-back-btn:hover
  color --text-primary

.scene-incoming-list
  display flex
  flex-direction column
  border-top 1px solid --border-subtle
  margin-bottom -1px

.incoming-choice-btn
  padding 10px 36px
  border-bottom 1px solid --border-subtle
  font-size 14px

.incoming-choice-content
  display inline-flex
  align-items baseline
  flex-wrap wrap
  gap 6px
  min-width 0

.incoming-scene-name
  font-weight 500
  color --text-secondary
  transition color 0.15s ease

.incoming-choice-sep, .incoming-choice-label
  font-size 13px
  color --text-muted
  transition color 0.15s ease

.incoming-choice-btn:hover .incoming-scene-name,
.incoming-choice-btn:hover .incoming-choice-sep,
.incoming-choice-btn:hover .incoming-choice-label
  color --text-primary

.incoming-choice-arrow
  font-size 16px

.active-scene-stage.scene-text-editor-stage
  flex 1 0 auto
  height auto

.active-scene-stage .scene-card.scene-text-editor-card
  flex 1 0 auto
  height auto

.scene-text-editor-card .scene-header-block
  padding 0

.scene-text-editor-card .scene-title-row
  padding 10px 36px

.scene-settings-toggle-btn
  position relative
  width 30px
  height 30px
  padding 0
  display inline-flex
  align-items center
  justify-content center
  color --text-secondary
  flex-shrink 0
  transition color 0.15s ease

.scene-settings-toggle-btn:hover, .scene-settings-toggle-btn.active
  color --text-primary

.scene-settings-toggle-btn.active::before, .scene-settings-toggle-btn.active::after
  content ""
  position absolute
  left 0
  right 0
  height 6px
  border-left 1px solid currentColor
  border-right 1px solid currentColor
  pointer-events none

.scene-settings-toggle-btn.active::before
  top 0
  background linear-gradient(to right, currentColor 6px, transparent 6px, transparent calc(100% - 6px), currentColor calc(100% - 6px)) 0 0 / 100% 1px no-repeat

.scene-settings-toggle-btn.active::after
  bottom 0
  background linear-gradient(to right, currentColor 6px, transparent 6px, transparent calc(100% - 6px), currentColor calc(100% - 6px)) 0 100% / 100% 1px no-repeat

.scene-settings-icon
  width 16px
  height 16px
  display block
  pointer-events none

.scene-settings-block
  width 100%
  padding 14px 36px
  background --bg-obsidian
  border-top 1px solid --border-subtle
  display flex
  flex-direction column
  gap 10px

@media (max-width: 760px)
  .scene-text-editor-card .scene-title-row
    padding 8px 20px

  .scene-settings-block
    padding 12px 20px

.scene-settings-row
  display flex
  align-items center
  gap 8px
  width 100%
  min-width 0

.scene-settings-row .node-meta-key
  width 48px
  font-size 11px

.scene-settings-row .node-meta-input
  flex 1
  min-width 0
  height 30px
  font-size 12px
  padding 0
  background transparent
  border none
  border-bottom 1px solid transparent
  color --text-primary
  transition border-color 0.15s ease

.scene-settings-row .node-meta-input:hover
  border-bottom-color --border-strong

.scene-settings-row .node-meta-input:focus, .scene-settings-row .node-meta-input:active
  border-bottom-color --text-primary
  outline none

.scene-settings-row .custom-select.node-media-select
  flex 1
  min-width 0

.scene-settings-row .custom-select-trigger
  height 30px
  font-size 12px
  padding 0

.scene-settings-row .custom-select-option
  font-size 12px
  padding 7px 10px

.scene-settings-row .node-media-add-btn
  width 30px
  height 30px
  padding 0

.scene-start-star-btn
  width 30px
  height 30px
  padding 0
  display inline-flex
  align-items center
  justify-content center
  background --bg-obsidian
  border 1px solid --border-strong
  color --text-primary
  cursor pointer
  flex-shrink 0
  transition color 0.15s ease, border-color 0.15s ease, background 0.15s ease

.scene-start-star-btn:hover
  border-color --text-primary
  background --bg-elevated
  color --text-primary

.scene-start-star-btn.active
  border-color --text-primary
  background --bg-elevated
  color --text-primary
  cursor default

.scene-star-icon, .scene-settings-row .media-plus-icon, .modal-add-choice-btn .media-plus-icon
  width 15px
  height 15px
  display block
  flex-shrink 0
  pointer-events none

.scene-body-block.scene-text-editor-body
  display flex
  flex-direction column
  flex 1 0 auto
  height auto
  gap 18px

.modal-scene-textarea
  display block
  width 100%
  min-height 320px
  flex 0 0 auto
  padding 16px 0 24px
  background transparent
  border none
  color --text-primary
  resize none
  overflow-y hidden
  outline none

.modal-choice-row
  gap 12px
  padding 7px 4px
  cursor default

.modal-choice-row input.choice-label-text
  font-family --font-sans
  font-size inherit
  line-height inherit
  font-weight 400
  color --text-primary
  padding 2px 0

.modal-choice-lead-btn
  flex 1
  min-width 0
  display flex
  align-items center
  background transparent
  border none
  padding 0
  color inherit
  font-family inherit
  font-size inherit
  line-height inherit
  text-align left
  cursor pointer

.modal-choice-controls
  display flex
  align-items center
  gap 6px
  flex-shrink 0

.modal-choice-select
  width auto
  max-width none
  flex-shrink 0

.modal-choice-select .custom-select-menu
  bottom calc(100% + 4px)
  top auto
  right 0
  left auto
  min-width 240px

.modal-choice-nav-btn
  width 28px
  height 28px
  padding 0
  margin-left 0
  display inline-flex
  align-items center
  justify-content center
  color --text-secondary
  transition color 0.15s ease

.modal-choice-nav-btn:hover
  color --text-primary

.modal-choice-nav-btn .choice-arrow
  margin-left 0

.modal-add-choice-btn
  width 30px
  height 30px
  margin-top 10px
  padding 0
  align-self flex-end

body[data-ui-scale="large"]
  .modal-card
    max-width 560px
    padding 28px

  .modal-title
    font-size 23px

  .modal-desc, .field-input, .help-list
    font-size 16px

  .scene-text-back-btn
    font-size 12px

  .incoming-choice-btn
    font-size 16px
    padding 12px 36px

  .incoming-choice-sep, .incoming-choice-label
    font-size 14px

  .incoming-choice-arrow
    font-size 18px

  .scene-text-editor-card .scene-header-block
    padding 0

  .scene-text-editor-card .scene-title-row
    padding 13px 36px

  .modal-choice-nav-btn, .scene-settings-toggle-btn, .scene-start-star-btn, .scene-settings-row .node-media-add-btn, .modal-add-choice-btn
    width 34px
    height 34px

  .scene-settings-icon, .scene-star-icon, .scene-settings-row .media-plus-icon, .modal-add-choice-btn .media-plus-icon
    width 17px
    height 17px

  .scene-settings-row .node-meta-key
    font-size 13px
    width 56px

  .scene-settings-row .node-meta-input, .scene-settings-row .custom-select-trigger
    height 34px
    font-size 14px

  .scene-settings-row .custom-select-option
    font-size 14px
