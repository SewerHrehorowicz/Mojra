.modal-backdrop
  position absolute
  inset 0
  pointer-events auto
  background rgba(0, 0, 0, 0.85)
  display flex
  align-items center
  justify-content center
  padding 20px
  z-index 120

#modal-confirm
  z-index 130

.modal-card
  width 100%
  max-width 440px
  background --bg-obsidian
  border 1px solid --border-subtle
  overflow hidden

.modal-card-lg
  max-width 640px

.modal-header
  padding 22px 24px 0
  display flex
  align-items center
  justify-content space-between

.modal-title
  font-family --font-serif
  font-size 19px
  font-weight 400
  color --text-primary

.modal-body
  padding 14px 24px 22px
  display flex
  flex-direction column
  gap 16px

.modal-desc
  font-size 14px
  line-height 1.6
  color --text-secondary

.qr-modal-body
  align-items center
  text-align center

.qr-modal-body .modal-meta-fields
  text-align left
  align-items stretch

.settings-modal-actions
  display flex
  flex-wrap wrap
  justify-content center
  gap 10px
  width 100%
  padding-bottom 4px

.qr-frame
  padding 14px
  background #ffffff
  display inline-flex

.qr-image
  width 220px
  height 220px
  display block
  image-rendering pixelated

.lan-url-box
  font-family --font-sans
  font-size 13px
  color --text-primary
  padding 4px 0
  user-select all

.form-field
  display flex
  flex-direction column
  gap 6px

.field-label
  font-size 11px
  text-transform uppercase
  letter-spacing 0.8px
  color --text-muted

.field-input
  width 100%
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 13px
  padding 5px 0
  transition border-color 0.15s ease

.field-input::placeholder
  color --text-muted
  font-weight 300
  opacity 1

.field-input:focus
  outline none
  border-bottom-color --text-primary

.modal-meta-fields
  gap 10px
  width 100%

.modal-meta-fields .node-meta-key
  width 64px
  font-size 13px

.modal-meta-fields .node-meta-input, .modal-meta-fields .custom-select-trigger, .modal-meta-fields .book-setting-toggle-btn, .modal-meta-fields .form-toggle-btn, .modal-meta-fields .form-radio-option
  font-size 13px
  padding 4px 0

.modal-meta-fields .custom-select-option
  font-size 13px
  padding 7px 10px

.modal-meta-fields .node-meta-row
  gap 10px
  min-height 28px

.checkbox-field .checkbox-label
  display flex
  align-items flex-start
  gap 8px
  font-size 13px
  line-height 1.45
  color --text-secondary
  cursor pointer

.modal-actions
  padding-top 6px
  display flex
  justify-content flex-end
  gap 10px
  width 100%

.add-book-section
  display flex
  flex-direction column
  gap 8px
  padding-bottom 14px
  border-bottom 1px solid --border-subtle

.add-book-browse-row
  display flex
  align-items center
  gap 8px
  flex-wrap wrap

.add-book-inline-form
  display flex
  align-items stretch
  gap 8px

.add-book-inline-form .field-input
  flex 1

.studio-projects-list
  display flex
  flex-direction column
  max-height 220px
  overflow-y auto

.studio-project-row
  display flex
  align-items center
  justify-content space-between
  gap 12px
  width 100%
  padding 8px 0
  background transparent
  border none
  border-bottom 1px solid --border-subtle
  color --text-primary
  font-family --font-sans
  text-align left
  cursor pointer

.studio-project-row:hover, .studio-project-row.active
  border-bottom-color --text-primary

.studio-project-main
  display flex
  align-items baseline
  gap 10px
  min-width 0
  flex 1

.studio-project-title
  font-size 13px
  font-weight 500
  color --text-primary
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.studio-project-author
  font-size 11px
  color --text-muted
  white-space nowrap

.studio-project-badge
  font-family --font-mono
  font-size 10px
  letter-spacing 0.5px
  color --text-secondary
  flex-shrink 0

.help-shortcuts-list
  display flex
  flex-direction column

.help-shortcut-row
  display flex
  flex-direction column
  gap 4px
  padding 10px 0
  border-bottom 1px solid --border-subtle

.help-shortcut-row:first-child
  padding-top 0

.help-shortcut-row:last-child
  border-bottom none

.help-shortcut-key
  font-family --font-sans
  font-size 11px
  font-weight 600
  color --text-primary

.help-shortcut-desc
  font-size 12px
  line-height 1.45
  color --text-secondary

@keyframes sceneTextSlideInLeft
  from
    transform translateX(-100%)
  to
    transform translateX(0)

.modal-backdrop.scene-text-fullscreen-backdrop
  top 36px
  left 0
  right 0
  bottom 0
  padding 0
  background --bg-obsidian
  backdrop-filter none
  align-items stretch
  justify-content stretch
  overflow hidden
  will-change transform, right
  transition right 0.22s cubic-bezier(0.22, 1, 0.36, 1), transform 0.22s cubic-bezier(0.22, 1, 0.36, 1)

.modal-backdrop.scene-text-fullscreen-backdrop.is-entering
  animation sceneTextSlideInLeft 0.22s cubic-bezier(0.22, 1, 0.36, 1)

.modal-backdrop.scene-text-fullscreen-backdrop.is-collapsing
  transform translateX(-100%)
  pointer-events none

.modal-backdrop.scene-text-fullscreen-backdrop.mode-half
  right 50%
  border-right 1px solid --border-subtle

.modal-backdrop.scene-text-fullscreen-backdrop.mode-half .player-bg-stage,
.modal-backdrop.scene-text-fullscreen-backdrop.mode-half .scene-illustration-spacer
  display none !important

.modal-backdrop.scene-text-fullscreen-backdrop.mode-half .story-scroll-feed.scene-text-editor-feed
  width min(960px, 100%)
  max-width 960px
  min-width 0
  margin-left auto
  margin-right auto
  border-left 1px solid --border-subtle
  border-right 1px solid --border-subtle

.modal-backdrop.scene-text-fullscreen-backdrop.mode-half.has-right-panel,
.workspace:has(#editor-workspace-body > aside:not(.hidden)) + .modals-root .modal-backdrop.scene-text-fullscreen-backdrop.mode-half
  right 320px
  border-right 1px solid --border-subtle

.modal-backdrop.scene-text-fullscreen-backdrop.mode-full
  right 0
  border-right none

@media (max-width: 760px)
  .modal-backdrop.scene-text-fullscreen-backdrop.mode-half,
  .modal-backdrop.scene-text-fullscreen-backdrop.mode-half.has-right-panel,
  .workspace:has(#editor-workspace-body > aside:not(.hidden)) + .modals-root .modal-backdrop.scene-text-fullscreen-backdrop.mode-half
    right 0
    border-right none

/* @dev-only-start */
.device-stage[data-preview="portrait"] .modal-backdrop.scene-text-fullscreen-backdrop.mode-half,
.device-stage[data-preview="portrait"] .modal-backdrop.scene-text-fullscreen-backdrop.mode-half.has-right-panel,
.device-stage[data-preview="portrait"] .workspace:has(#editor-workspace-body > aside:not(.hidden)) + .modals-root .modal-backdrop.scene-text-fullscreen-backdrop.mode-half
  right 0
  border-right none
/* @dev-only-end */

.scene-text-book-layout
  width 100%
  height 100%
  min-height 0

.scene-text-editor-feed
  height 100%
  min-height 0

.scene-text-expand-btn
