#view-library, .studio-home-container
  padding 16px 24px
  overflow-y auto
  max-width 1680px
  margin 0 auto
  width 100%

#view-editor:has(> .studio-home-container)
  overflow-y auto

.library-top-actions
  display flex
  align-items center
  gap 8px
  flex-wrap wrap

.bookshelf-header
  display flex
  align-items center
  justify-content flex-end
  padding-bottom 12px
  border-bottom 1px solid --border-subtle

.bookshelf-empty
  padding 48px 0
  text-align center
  color --text-muted
  font-size 15px

.bookshelf-grid
  display grid
  grid-template-columns 1fr
  column-gap 36px
  align-items stretch

.book-card
  display grid
  grid-template-columns 120px 1fr
  align-items start
  gap 20px
  padding 24px 0
  background transparent
  border-bottom 1px solid --border-subtle
  min-width 0

.book-cover-wrap
  position relative
  width 120px
  height 120px
  aspect-ratio 1 / 1
  padding 0
  border none
  background --bg-elevated
  overflow hidden
  cursor pointer
  display block

.book-cover-img
  width 100%
  height 100%
  object-fit cover
  display block
  transition transform 0.2s ease

.book-cover-wrap:hover .book-cover-img
  transform scale(1.03)

.book-cover-play-overlay
  position absolute
  inset 0
  display flex
  align-items center
  justify-content center
  background rgba(0, 0, 0, 0.2)
  transition background 0.18s ease

.book-cover-wrap:hover .book-cover-play-overlay
  background rgba(0, 0, 0, 0.38)

.book-cover-play-icon
  width 44px
  height 44px
  color rgba(255, 255, 255, 0.9)
  display block
  transition transform 0.18s ease, color 0.18s ease

.book-cover-wrap:hover .book-cover-play-icon
  transform scale(1.08)
  color #ffffff

.book-cover-wrap:has(> .is-default-cover), .studio-project-cover-wrap
  background-color --bg-surface
  background-image linear-gradient(to right, --border-subtle 1px, transparent 1px), linear-gradient(to bottom, --border-subtle 1px, transparent 1px)
  background-size 24px 24px

.book-cover-play-overlay.is-default-cover, .studio-project-cover-wrap .book-cover-play-overlay
  background transparent

.book-cover-wrap:hover .book-cover-play-overlay.is-default-cover, .studio-project-cover-wrap:hover .book-cover-play-overlay
  background rgba(0, 0, 0, 0.25)

.book-cover-play-overlay.is-default-cover .book-cover-play-icon, .book-cover-play-icon.studio-project-cover-icon
  width 28px
  height 28px
  color --text-secondary

.book-cover-wrap:hover .book-cover-play-overlay.is-default-cover .book-cover-play-icon, .studio-project-cover-wrap:hover .book-cover-play-icon.studio-project-cover-icon
  color --text-primary

.book-card-body
  display flex
  flex-direction column
  justify-content center
  gap 6px
  min-width 0

.book-card-meta
  display flex
  align-items center
  gap 12px

.book-card-title
  font-family --font-serif
  font-size 21px
  font-weight 400
  color --text-primary

.book-card-author
  font-size 11px
  text-transform uppercase
  letter-spacing 1px
  color --text-muted

.book-progress-bar
  -webkit-appearance none
  appearance none
  width 72px
  height 3px
  border none
  background --border-subtle
  overflow hidden
  display block

.book-progress-bar::-webkit-progress-bar
  background --border-subtle

.book-progress-bar::-webkit-progress-value
  background --text-secondary

.book-progress-bar::-moz-progress-bar
  background --text-secondary

.book-card-desc
  font-family --font-sans
  font-weight 300
  font-size 15px
  color --text-secondary
  line-height 1.65
  margin-top 4px

.book-card-desc.studio-project-path
  font-family --font-mono
  font-size 12px
  color --text-muted

.studio-packed-grid
  margin-top 8px
  column-gap 24px

.book-card.studio-packed-card
  grid-template-columns 72px 1fr
  gap 14px
  padding 16px 0

.book-cover-wrap.studio-packed-cover-wrap
  width 72px
  height 72px
  background-size 18px 18px

.studio-packed-cover-wrap .book-cover-play-icon.studio-project-cover-icon
  width 20px
  height 20px

.studio-packed-card .book-card-title
  font-size 16px

.studio-packed-card .book-card-author
  font-size 10px

.studio-packed-card .book-card-desc.studio-project-path
  font-size 11px

.book-card.studio-packed-card.is-unpacked
  opacity 0.38

.book-card.studio-packed-card.is-unpacked .studio-packed-cover-wrap
  cursor default

.book-card.studio-packed-card.is-unpacked .studio-packed-cover-wrap:hover .book-cover-play-overlay
  background transparent

.book-card.studio-packed-card.is-unpacked .studio-packed-cover-wrap:hover .book-cover-play-icon.studio-project-cover-icon
  color --text-secondary
  transform none

.home-mode-footer
  margin-top 24px
  padding-top 16px
  border-top 1px solid --border-subtle
  display flex
  align-items center

.home-mode-switch-btn
  display inline-flex
  align-items center
  gap 10px
  padding 6px 0
  background transparent
  border none
  color --text-secondary
  font-family --font-sans
  font-size 12px
  cursor pointer
  transition color 0.14s ease

.home-mode-switch-btn:hover
  color --text-primary

.home-mode-switch-icon
  width 16px
  height 16px
  color --text-primary
  flex-shrink 0
  pointer-events none

.home-mode-switch-target
  color --text-primary
  font-weight 600

body[data-ui-scale="large"]
  .book-card
    grid-template-columns 144px 1fr
    gap 28px
    padding 28px 0

  .book-cover-wrap
    width 144px
    height 144px

  .book-cover-play-icon
    width 56px
    height 56px

  .book-progress-bar
    width 96px
    height 5px

@media (min-width: 900px)
  .bookshelf-grid
    grid-template-columns repeat(2, minmax(0, 1fr))

@media (min-width: 1380px)
  .bookshelf-grid
    grid-template-columns repeat(3, minmax(0, 1fr))

@media (max-width: 600px)
  #view-library, .studio-home-container
    padding 12px 14px

  .book-card
    grid-template-columns 96px 1fr
    gap 16px
    padding 16px 0

  .book-cover-wrap
    width 96px
    height 96px

  .book-card-title
    font-size 18px

  .book-card-desc
    font-size 14px

/* @dev-only-start */
.bookshelf-grid
  @switch preview
    portrait, landscape
      grid-template-columns 1fr !important

#view-library, .studio-home-container
  @switch preview
    portrait
      padding 12px 14px

.book-card
  @switch preview
    portrait
      grid-template-columns 96px 1fr
      gap 16px
      padding 16px 0

.book-cover-wrap
  @switch preview
    portrait
      width 96px
      height 96px

.book-card-title
  @switch preview
    portrait
      font-size 18px

.book-card-desc
  @switch preview
    portrait
      font-size 14px
/* @dev-only-end */
