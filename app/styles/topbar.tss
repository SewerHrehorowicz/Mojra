.topbar
  grid-row 1
  grid-column 1
  position relative
  z-index 200
  display flex
  align-items center
  justify-content flex-start
  padding 4px 8px
  min-height 32px
  background --bg-topbar
  border-bottom 1px solid --border-subtle
  flex-shrink 0
  gap 4px
  -webkit-app-region drag

.topbar button
  -webkit-app-region no-drag

.topbar-left, .topbar-center, .topbar-right
  display flex
  align-items center

.topbar-left
  gap 4px
  min-width 0

.topbar-center
  gap 4px
  min-width 0

.topbar-right
  position relative
  margin-left auto
  gap 4px
  flex-shrink 0

.topbar-divider
  width 1px
  height 14px
  background --border-subtle
  display block
  flex-shrink 0
  margin 0 2px

.topbar-icon-tab
  padding 4px

.topbar-icon-tab .tab-icon
  width 15px
  height 15px

.topbar-hamburger-btn, .top-action-btn.topbar-hamburger-btn
  display none !important

.topbar-actions-menu
  display flex
  align-items center
  gap 4px

.brand-mark
  width 16px
  height 16px
  display block
  flex-shrink 0
  color --text-primary
  margin 0 2px
  pointer-events none

.brand-logo
  font-family --font-serif
  font-size 14px
  font-weight 700
  letter-spacing 0.6px
  color --text-primary
  padding 2px 6px 2px 2px
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  user-select none

.topbar-tab
  display inline-flex
  align-items center
  justify-content center
  gap 4px
  padding 4px
  border none !important
  text-decoration none !important
  background transparent
  color --text-secondary
  font-family --font-sans
  font-size 12px
  cursor pointer
  white-space nowrap
  max-width 240px
  overflow hidden
  text-overflow ellipsis
  flex-shrink 0

.topbar-tab:hover
  color --text-primary
  border none !important
  text-decoration none !important

.tab-icon
  width 15px
  height 15px
  display block
  flex-shrink 0
  pointer-events none

.tab-label
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.topbar-tab.active
  color --text-primary
  font-weight 600
  border none !important
  text-decoration none !important

.top-action-btn
  position relative
  display inline-flex
  align-items center
  justify-content center
  gap 4px
  padding 4px
  border none !important
  text-decoration none !important
  background transparent
  color --text-secondary
  font-size 11px
  cursor pointer

.top-action-btn:hover, .top-action-btn.active
  color --text-primary
  border none !important
  text-decoration none !important

.top-action-btn:disabled, .top-action-btn.is-disabled, body[data-imageless-locked="true"] #btn-toggle-imageless
  opacity 0.38
  cursor not-allowed
  pointer-events none
  color --text-muted

.btn-quit-app
  color --text-secondary
  font-weight 400

.action-icon
  width 15px
  height 15px
  display block
  flex-shrink 0
  pointer-events none

#icon-imageless-on, #icon-zoom-out, #icon-zoom-zen, #icon-theme-moon
  display none

body[data-imageless="true"] #icon-imageless-off, body[data-imageless-locked="true"] #icon-imageless-off
  display none

body[data-imageless="true"] #icon-imageless-on, body[data-imageless-locked="true"] #icon-imageless-on
  display block

body[data-ui-scale="large"] #icon-zoom-in, body[data-ui-scale="large"] #icon-zoom-out
  display none

body[data-ui-scale="large"] #icon-zoom-zen
  display block

body[data-ui-scale="zen"] #icon-zoom-in, body[data-ui-scale="zen"] #icon-zoom-zen
  display none

body[data-ui-scale="zen"] #icon-zoom-out
  display block

body[data-ui-scale="zen"]
  #tab-library, #tab-editor, .topbar-divider, #btn-topbar-menu, #btn-toggle-imageless, #btn-toggle-fullscreen, .topbar-actions-menu button[action="PromptResetProgress"], .topbar-actions-menu button[action="OpenQRModal"]
    display none !important

body[data-theme="light"] #icon-theme-sun
  display none

body[data-theme="light"] #icon-theme-moon
  display block

body[data-ui-scale="large"]
  .topbar
    padding 6px 10px
    min-height 40px
    gap 8px

  .topbar-left, .topbar-right, .topbar-actions-menu
    gap 6px

  .topbar-divider
    height 16px

  .brand-mark
    width 18px
    height 18px

  .brand-logo
    font-size 15px
    padding 2px 6px 2px 2px

  .topbar-tab, .topbar-icon-tab, .top-action-btn
    padding 5px
    font-size 13px

  .tab-icon, .topbar-icon-tab .tab-icon, .action-icon
    width 18px
    height 18px

/* @dev-only-start */
.device-frame .topbar
  padding 4px 8px

.topbar
  @switch preview
    portrait, tablet, landscape
      padding 4px 8px
      gap 6px

.desktop-only-btn
  display switch(preview)
    portrait, tablet, landscape none !important

.topbar-left
  @switch preview
    portrait
      gap 4px

.topbar-hamburger-btn, .top-action-btn.topbar-hamburger-btn
  display switch(preview)
    portrait inline-flex !important

.topbar-actions-menu
  @switch preview
    portrait
      display none
      position absolute
      top calc(100% + 6px)
      right 0
      background --bg-obsidian
      border 1px solid --text-primary
      padding 6px 8px
      gap 6px
      align-items center
      z-index 120
      box-shadow 0 6px 18px rgba(0, 0, 0, 0.45)

.topbar-actions-menu.open
  display switch(preview)
    portrait flex !important
/* @dev-only-end */

@media (max-width: 900px)
  .topbar
    padding 6px
    gap 4px

  .desktop-only-btn
    display none !important

@media (max-width: 620px)
  .topbar
    padding 4px 8px
    gap 4px

  .topbar-left
    gap 4px

  .topbar-hamburger-btn, .top-action-btn.topbar-hamburger-btn
    display inline-flex !important

  .topbar-actions-menu
    display none
    position absolute
    top calc(100% + 6px)
    right 0
    background --bg-obsidian
    border 1px solid --text-primary
    padding 6px 8px
    gap 6px
    align-items center
    z-index 120
    box-shadow 0 6px 18px rgba(0, 0, 0, 0.45)

  .topbar-actions-menu.open
    display flex !important
