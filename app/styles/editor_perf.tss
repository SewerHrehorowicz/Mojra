.editor-perf-overlay
  position absolute
  bottom 12px
  left 14px
  z-index 45
  display inline-flex
  align-items center
  gap 10px
  padding 5px 10px
  background --bg-obsidian
  border 1px solid --border-strong
  color --text-secondary
  font-family --font-mono
  font-size 11px
  line-height 1.3
  letter-spacing 0.2px
  pointer-events none
  user-select none
  opacity 0.92

.editor-perf-overlay-val
  color --text-primary
  font-weight 600

.editor-perf-overlay-sep
  color --border-strong
