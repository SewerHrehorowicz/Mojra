*, *::before, *::after
  box-sizing border-box
  margin 0
  padding 0
  border-radius 0 !important
  scrollbar-width none !important
  -ms-overflow-style none !important

*::-webkit-scrollbar
  display none !important
  width 0 !important
  height 0 !important

*::-webkit-resizer
  display none !important

html, body
  width 100%
  height 100%
  overflow hidden
  background-color --bg-obsidian
  color --text-primary
  font-family --font-sans
  -webkit-font-smoothing antialiased
  user-select none

button, input, textarea, select
  font-family inherit

input, textarea
  user-select text
  -webkit-user-select text
  cursor text

.hidden
  display none !important

// Shared Buttons
.btn
  display inline-flex
  align-items center
  justify-content center
  gap 8px
  padding 6px 12px
  font-family --font-sans
  font-size 10px
  font-weight 500
  text-transform uppercase
  letter-spacing 0.6px
  border 1px solid --border-strong
  background --bg-obsidian
  color --text-primary
  cursor pointer
  transition
    border-color 0.15s ease
    background 0.15s ease
    color 0.15s ease
    opacity 0.15s ease

.btn:hover
  border-color --text-primary
  background --bg-elevated

.btn-primary
  background --accent-bg
  color --accent-fg-inverted
  border-color --accent-bg
  font-weight 600

.btn-primary:hover
  opacity 0.88
  background --accent-bg
  border-color --accent-bg

.btn-danger
  color --accent-danger
  border-color --accent-danger
  background --bg-obsidian

.btn-danger:hover
  color --accent-danger
  background --bg-elevated
  border-color --accent-danger

.btn-sm
  padding 5px 10px
  font-size 10px
  gap 6px

.btn-icon
  width 15px
  height 15px

.node-close-btn
  width 28px
  height 28px
  display inline-flex
  align-items center
  justify-content center
  background transparent
  border none !important
  text-decoration none !important
  color --text-secondary
  cursor pointer
  padding 0
  flex-shrink 0
  transition color 0.15s ease

.node-close-btn:hover
  color --text-primary

.node-close-icon
  width 15px
  height 15px
  display block
  flex-shrink 0
  pointer-events none

// Universal 4-Corner Selection for Single-Icon Toggles (without separate on/off icons)
.top-action-btn, .scene-settings-toggle-btn, .scene-preview-mode-btn, .choice-rule-toggle-btn, .choice-syntax-help-btn, .deck-chip, .icon-toggle-btn
  position relative

.top-action-btn.active, .scene-settings-toggle-btn.active, .scene-preview-mode-btn.active, .choice-rule-toggle-btn.active, .choice-syntax-help-btn.active, .deck-chip.chip-active, .icon-toggle-btn.active
  color --text-primary

.top-action-btn.active:not(#btn-toggle-imageless)::before,
.top-action-btn.active:not(#btn-toggle-imageless)::after,
.scene-settings-toggle-btn.active::before,
.scene-settings-toggle-btn.active::after,
.scene-preview-mode-btn.active::before,
.scene-preview-mode-btn.active::after,
.choice-rule-toggle-btn.active::before,
.choice-rule-toggle-btn.active::after,
.choice-syntax-help-btn.active::before,
.choice-syntax-help-btn.active::after,
.deck-chip.chip-active::before,
.deck-chip.chip-active::after,
.icon-toggle-btn.active::before,
.icon-toggle-btn.active::after
  content ""
  position absolute
  left 0
  right 0
  height 5px
  border-left 1px solid currentColor
  border-right 1px solid currentColor
  pointer-events none

.top-action-btn.active:not(#btn-toggle-imageless)::before,
.scene-settings-toggle-btn.active::before,
.scene-preview-mode-btn.active::before,
.choice-rule-toggle-btn.active::before,
.choice-syntax-help-btn.active::before,
.deck-chip.chip-active::before,
.icon-toggle-btn.active::before
  top 0
  background
    linear-gradient(to right)
      currentColor 5px
      transparent 5px
      transparent calc(100% - 5px)
      currentColor calc(100% - 5px)
    0 0 / 100% 1px no-repeat

.top-action-btn.active:not(#btn-toggle-imageless)::after,
.scene-settings-toggle-btn.active::after,
.scene-preview-mode-btn.active::after,
.choice-rule-toggle-btn.active::after,
.choice-syntax-help-btn.active::after,
.deck-chip.chip-active::after,
.icon-toggle-btn.active::after
  bottom 0
  background
    linear-gradient(to right)
      currentColor 5px
      transparent 5px
      transparent calc(100% - 5px)
      currentColor calc(100% - 5px)
    0 100% / 100% 1px no-repeat

body[data-ui-scale="large"]
  .btn
    padding 8px 14px
    font-size 12px
    gap 8px

  .btn-sm
    padding 6px 10px
    font-size 11px
    gap 6px

  .btn-icon
    width 18px
    height 18px

  .node-close-btn
    width 32px
    height 32px

  .node-close-icon
    width 18px
    height 18px

// Shared Warning Callout
.book-warnings-box
  margin-top 10px
  padding 10px 14px
  background --bg-elevated
  border 1px solid --accent-danger
  color --text-primary
  font-size 12px

.book-warnings-title
  font-family --font-sans
  font-size 11px
  font-weight 600
  color --accent-danger
  margin-bottom 6px

.book-warnings-list
  margin 0
  padding-left 18px
  color --text-secondary
  line-height 1.5
