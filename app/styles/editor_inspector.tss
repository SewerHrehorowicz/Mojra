// Contextual Left Inspector Panel & Multi-Selection
.editor-context-panel
  order 1
  width 288px
  min-width 288px
  max-width 288px
  height 100%
  background --bg-obsidian
  border-right 1px solid --border-subtle
  overflow-y auto
  overflow-x hidden
  display flex
  flex-direction column
  flex-shrink 0
  z-index 35

body[data-android="true"] .editor-context-panel
  display none !important

/* @dev-only-start */
.device-stage[data-preview="portrait"] .editor-context-panel, .device-stage[data-preview="landscape"] .editor-context-panel
  display none !important
/* @dev-only-end */

@media (max-width: 900px)
  .editor-context-panel
    display none !important

@media (hover: none) and (pointer: coarse)
  .editor-context-panel
    display none !important

// Right-Side Version History & Breakdown Panels
.editor-history-panel, .editor-breakdown-panel
  order 3
  width 300px
  min-width 300px
  max-width 300px
  height 100%
  background --bg-obsidian
  border-left 1px solid --border-subtle
  overflow-y auto
  overflow-x hidden
  display flex
  flex-direction column
  flex-shrink 0
  z-index 35

.editor-history-panel
  overflow hidden

.editor-breakdown-panel
  width 320px
  min-width 320px
  max-width 320px

.canvas-script-summary
  font-family --font-sans
  font-size 10px
  color --text-muted
  padding 2px 8px
  border-left 1px solid --border-subtle
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.history-branch-diff
  margin-top 4px
  font-family --font-sans
  font-size 10px
  color --text-secondary

.history-branch-actions
  display flex
  align-items center
  gap 4px
  flex-shrink 0

.breakdown-export-bar
  display flex
  flex-wrap wrap
  gap 6px
  padding 10px 14px
  border-bottom 1px solid --border-subtle
  background --bg-elevated
  flex-shrink 0

.breakdown-metrics-grid
  display grid
  grid-template-columns 1fr 1fr
  gap 6px

.breakdown-metric-card
  display flex
  flex-direction column
  gap 2px
  padding 6px 8px
  background --bg-elevated
  border 1px solid --border-subtle

.breakdown-metric-label
  font-family --font-sans
  font-size 9px
  text-transform uppercase
  letter-spacing 0.5px
  color --text-muted

.breakdown-metric-value
  font-family --font-sans
  font-size 12px
  font-weight 600
  color --text-primary

.breakdown-item-card
  display flex
  flex-direction column
  gap 5px
  padding 8px 10px
  background --bg-elevated
  border 1px solid --border-subtle

.breakdown-item-top
  display flex
  align-items center
  justify-content space-between
  gap 6px

.breakdown-jump-btn
  background transparent
  border none
  padding 0
  text-align left
  cursor pointer
  color --text-primary
  flex 1
  min-width 0

.breakdown-rename-form
  display flex
  align-items center
  gap 4px
  margin-top 2px

.node-slugline-input
  font-family --font-screenplay
  font-weight 700
  text-transform uppercase

.node-script-length-badge
  font-family --font-sans
  font-size 9px
  font-weight 600
  padding 1px 5px
  border 1px solid --border-subtle
  background --bg-elevated
  color --text-secondary
  white-space nowrap
  flex-shrink 0

.slugline-helper-pills
  display flex
  flex-wrap wrap
  gap 4px
  padding 2px 0 4px

.slugline-pill-btn
  background --bg-elevated
  border 1px solid --border-subtle
  color --text-secondary
  font-family --font-sans
  font-size 9px
  font-weight 600
  padding 2px 6px
  cursor pointer

.slugline-pill-btn:hover
  border-color --text-primary
  color --text-primary

.history-panel-header
  display flex
  align-items center
  justify-content space-between
  gap 8px
  padding 10px 14px
  border-bottom 1px solid --border-subtle
  background --bg-topbar
  flex-shrink 0

.history-panel-title
  font-family --font-sans
  font-size 11px
  font-weight 600
  text-transform uppercase
  letter-spacing 0.9px
  color --text-primary

.history-unsaved-banner
  padding 8px 14px
  border-bottom 1px solid --border-subtle
  background --bg-elevated
  flex-shrink 0

.history-unsaved-text
  font-family --font-sans
  font-size 11px
  color --text-primary

.history-unsaved-text.is-clean
  color --text-muted

.history-preview-banner
  display flex
  flex-direction column
  gap 6px
  padding 10px 14px
  border-bottom 1px solid --text-primary
  background --bg-elevated
  flex-shrink 0

.history-preview-banner-title
  font-family --font-sans
  font-size 11px
  font-weight 600
  color --text-primary

.history-preview-banner-actions
  display flex
  flex-wrap wrap
  gap 6px
  align-items center

.history-version-form
  display flex
  flex-direction column
  gap 6px
  padding 12px 14px
  border-bottom 1px solid --border-subtle
  background --bg-obsidian
  flex-shrink 0

.history-version-input-row
  display flex
  align-items center
  gap 6px

.history-version-input
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 11px
  padding 4px 0
  transition border-color 0.15s ease

.history-version-input::placeholder
  color --text-muted
  font-weight 300
  opacity 1

.history-version-input:focus
  outline none
  border-bottom-color --text-primary

.history-version-save-btn
  flex-shrink 0
  white-space nowrap

.history-panel-body
  display flex
  flex-direction column
  gap 16px
  padding 14px
  overflow-y auto
  flex 1

.history-panel-section
  display flex
  flex-direction column
  gap 8px

.history-items-list
  display flex
  flex-direction column
  gap 6px

.history-step-item
  width 100%
  display flex
  flex-direction column
  align-items stretch
  gap 3px
  padding 8px 10px
  background --bg-elevated
  border 1px solid --border-subtle
  color --text-primary
  font-family --font-sans
  text-align left
  cursor pointer
  transition border-color 0.12s ease, background 0.12s ease

.history-step-item:hover
  border-color --text-primary

.history-step-item.history-item-current
  border-color --text-primary
  box-shadow 0 0 0 1px --text-primary

.history-step-item.history-item-undone
  opacity 0.55

.history-step-top
  display flex
  align-items center
  justify-content space-between
  gap 6px
  width 100%

.history-step-label
  font-size 11px
  line-height 1.35
  color --text-primary
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  flex 1
  min-width 0

.history-step-badge
  font-family --font-sans
  font-size 9px
  font-weight 700
  text-transform uppercase
  letter-spacing 0.5px
  padding 1px 5px
  border 1px solid --border-strong
  color --text-secondary
  background --bg-obsidian
  flex-shrink 0

.history-step-meta
  display flex
  align-items center
  justify-content space-between
  width 100%

.history-step-time
  font-size 10px
  color --text-muted

.history-version-card
  display flex
  align-items center
  justify-content space-between
  gap 8px
  padding 8px 10px
  background --bg-elevated
  border 1px solid --border-subtle
  transition border-color 0.12s ease, background 0.12s ease

.history-version-card.history-version-clickable
  cursor pointer

.history-version-card.history-version-clickable:hover
  border-color --text-primary

.history-version-card.history-item-current
  border-color --text-primary
  box-shadow 0 0 0 1px --text-primary

.history-version-info
  display flex
  flex-direction column
  gap 2px
  min-width 0
  flex 1

.history-version-name
  font-family --font-sans
  font-size 12px
  font-weight 600
  color --text-primary
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.history-version-time
  font-family --font-sans
  font-size 10px
  color --text-muted

.history-restore-btn
  flex-shrink 0

.history-empty-note
  font-family --font-sans
  font-size 11px
  color --text-muted
  padding 6px 0

// Unified History & Branch Graph Timeline
.history-compact-form
  display flex
  align-items center
  gap 6px
  padding 8px 12px
  border-bottom 1px solid --border-subtle
  background --bg-obsidian
  flex-shrink 0

.history-branch-create-form
  border-top 1px solid --border-subtle
  border-bottom none

.history-active-branch-bar
  display flex
  align-items center
  gap 7px
  padding 6px 12px
  border-bottom 1px solid --border-subtle
  background --bg-elevated
  flex-shrink 0

.history-active-branch-dot
  width 6px
  height 6px
  border-radius 50% !important
  background --text-primary
  flex-shrink 0

.history-active-branch-name
  font-family --font-sans
  font-size 10px
  font-weight 700
  letter-spacing 0.8px
  text-transform uppercase
  color --text-primary
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.history-graph-scroll
  position relative
  display flex
  flex-direction column
  flex 1
  min-height 0
  overflow-y auto
  overflow-x hidden
  padding 10px 10px 18px 10px

.history-graph-list
  display flex
  flex-direction column
  gap 0
  width 100%

.history-graph-row
  position relative
  display flex
  align-items center
  width 100%
  height 28px
  min-height 28px
  max-height 28px
  flex-shrink 0
  --row-stem-color --border-subtle

.history-graph-row.is-active-lineage
  --row-stem-color --history-box-active-lineage

.history-graph-row.is-unnamed-step
  --row-stem-color --history-box-unnamed

.history-graph-row.is-current-row
  --row-stem-color --text-primary

.history-graph-row.is-undone-row
  opacity 0.5

.history-graph-row.is-dragging-source
  opacity 0.45

.history-graph-lanes
  display flex
  align-items stretch
  height 28px
  flex-shrink 0

.history-lane-cell
  position relative
  width 18px
  min-width 18px
  max-width 18px
  height 28px
  flex-shrink 0

.history-lane-rail-up
  position absolute
  left 8px
  top 0
  width 0
  height 14px
  border-left 1px solid --history-rail-inactive
  pointer-events none
  z-index 1

.history-lane-rail-down
  position absolute
  left 8px
  top 14px
  width 0
  height 14px
  border-left 1px solid --history-rail-inactive
  pointer-events none
  z-index 1

.history-lane-rail-up.is-active, .history-lane-rail-down.is-active
  border-left-color --text-primary
  z-index 2

.history-lane-rail-up.is-dashed, .history-lane-rail-down.is-dashed
  border-left-style dashed

.history-lane-cell.is-drop-target-rail .history-lane-rail-up, .history-lane-cell.is-drop-target-rail .history-lane-rail-down
  border-left-color --text-primary
  border-left-width 2px
  z-index 3

.history-lane-fork.is-corner
  position absolute
  left 0
  top 0
  width 9px
  height 14px
  border-right 1px solid --history-rail-inactive
  border-bottom 1px solid --history-rail-inactive
  border-bottom-right-radius 6px !important
  pointer-events none
  z-index 1

.history-lane-fork.is-horiz
  position absolute
  left 0
  top 13px
  width 18px
  height 0
  border-bottom 1px solid --history-rail-inactive
  pointer-events none
  z-index 1

.history-lane-fork.is-corner.is-active, .history-lane-fork.is-horiz.is-active
  border-color --text-primary
  z-index 2

.history-lane-compact.is-out
  position absolute
  left 0
  top 0
  width 9px
  height 6px
  border-right 1px solid --history-rail-inactive
  border-bottom 1px solid --history-rail-inactive
  border-bottom-right-radius 5px !important
  pointer-events none
  z-index 1

.history-lane-compact.is-horiz
  position absolute
  left 0
  top 5px
  width 18px
  height 0
  border-bottom 1px solid --history-rail-inactive
  pointer-events none
  z-index 1

.history-lane-compact.is-in
  position absolute
  left 8px
  top 5px
  width 10px
  height 9px
  border-left 1px solid --history-rail-inactive
  border-top 1px solid --history-rail-inactive
  border-top-left-radius 5px !important
  pointer-events none
  z-index 1

.history-lane-compact.is-out.is-active, .history-lane-compact.is-horiz.is-active, .history-lane-compact.is-in.is-active
  border-color --text-primary
  z-index 2

.history-lane-stem.is-start
  position absolute
  left 9px
  right 0
  top 13px
  height 1px
  background --row-stem-color
  pointer-events none
  z-index 3

.history-lane-stem.is-through
  position absolute
  left 0
  right 0
  top 13px
  height 1px
  background --row-stem-color
  pointer-events none
  z-index 3

.history-rail-hit
  position absolute
  inset 0
  width 100%
  height 100%
  background transparent
  border none
  padding 0
  cursor pointer
  z-index 3

.history-rail-node
  position absolute
  left 5px
  top 10px
  width 7px
  height 7px
  padding 0
  border-radius 50% !important
  border 1px solid --history-rail-inactive
  background --bg-obsidian
  cursor grab
  z-index 4
  transition transform 0.12s ease, border-color 0.12s ease, background 0.12s ease

.history-rail-node.is-active-lineage-node
  border-color --text-primary
  background --text-primary

.history-rail-node.is-unnamed-node
  width 5px
  height 5px
  left 6px
  top 11px
  border-color --text-secondary
  background --bg-obsidian

.history-rail-node.is-current-node
  left 3px
  top 8px
  width 11px
  height 11px
  border 2px solid --text-primary
  background --bg-obsidian
  box-shadow inset 0 0 0 2px --bg-obsidian, inset 0 0 0 4px --text-primary

.history-rail-node:hover
  border-color --text-primary
  transform scale(1.18)

.history-row-stem
  width 8px
  min-width 8px
  height 1px
  background --row-stem-color
  flex-shrink 0
  pointer-events none

.history-row-box
  display flex
  align-items center
  gap 6px
  flex 1
  min-width 0
  height 24px
  padding 0 7px 0 5px
  background --bg-obsidian
  border 1px solid --row-stem-color
  cursor pointer
  transition border-color 0.12s ease, background 0.12s ease

.history-graph-row.is-current-row .history-row-box
  background --bg-elevated
  border-color --text-primary

.history-row-box:hover
  border-color --text-primary

.history-row-grip
  font-family --font-sans
  font-size 10px
  line-height 1
  letter-spacing -1px
  color --text-muted
  cursor grab
  padding 2px 2px
  flex-shrink 0
  user-select none

.history-row-grip:hover
  color --text-primary

.history-row-title
  font-family --font-sans
  font-size 11px
  font-weight 400
  color --text-secondary
  overflow hidden
  text-overflow ellipsis
  white-space nowrap
  flex 1
  min-width 0

.history-graph-row.is-active-lineage .history-row-title
  color --text-primary
  font-weight 500

.history-graph-row.is-current-row .history-row-title
  color --text-primary
  font-weight 700

.history-graph-row.is-inactive-branch .history-row-title
  color --text-muted

.history-row-meta
  font-family --font-sans
  font-size 9px
  font-weight 400
  color --text-muted
  white-space nowrap
  flex-shrink 0

.history-graph-row.is-current-row .history-row-meta
  color --text-secondary

.history-drop-preview-row
  display flex
  align-items center
  width 100%
  height 26px
  margin-bottom 4px
  flex-shrink 0
  pointer-events none

.history-drop-preview-dot
  width 9px
  height 9px
  margin-left 4px
  border-radius 50% !important
  border 1px dashed --text-primary
  background --bg-obsidian
  flex-shrink 0

.history-drop-preview-stem
  width 10px
  height 1px
  border-top 1px dashed --text-primary
  flex-shrink 0

.history-drop-preview-box
  display flex
  align-items center
  justify-content space-between
  gap 6px
  flex 1
  min-width 0
  height 24px
  padding 0 8px
  border 1px dashed --text-primary
  background --bg-elevated


.editor-context-form, .editor-chapter-form, .editor-book-form
  display flex
  flex-direction column
  gap 12px
  padding 14px
  min-height 100%

.editor-multi-panel
  display flex
  flex-direction column
  gap 12px
  padding 14px
  min-height 100%

.context-multi-scene-list
  display flex
  flex-direction column
  gap 6px

.context-multi-scene-item
  display flex
  align-items center
  gap 4px
  background --bg-elevated
  border 1px solid --border-subtle
  padding 6px 8px

.context-multi-scene-item:hover
  border-color --text-primary

.context-multi-scene-select-btn
  flex 1
  min-width 0
  display flex
  flex-direction column
  gap 2px
  background transparent
  border none
  padding 0
  text-align left
  cursor pointer
  color --text-primary
  font-family --font-sans

.context-multi-scene-title
  font-size 12px
  font-weight 400
  color --text-primary
  line-height 1.3
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.context-multi-scene-meta
  font-size 9px
  font-weight 400
  color --text-muted
  text-transform uppercase
  letter-spacing 0.5px
  line-height 1.2
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.context-multi-scene-deselect-btn
  flex-shrink 0

.context-panel-section
  display flex
  flex-direction column
  gap 5px

.context-choices-section
  display flex
  flex-direction column
  gap 8px

.context-choices-list
  display flex
  flex-direction column
  gap 8px

.context-choice-item
  display flex
  align-items center
  gap 6px
  padding 2px 0
  background transparent
  border none

.context-choice-item .node-choice-label
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  padding 3px 0

.context-choice-item .node-choice-label:focus
  border-bottom-color --text-primary

.context-danger-zone
  margin-top auto
  padding-top 14px
  border-top 1px solid --border-subtle
  display flex
  flex-direction column
  align-items flex-start

.btn.context-delete-btn
  align-self flex-start
  gap 6px
  color --accent-danger
  border-color --accent-danger
  background --bg-obsidian

.btn.context-delete-btn .btn-icon
  width 13px
  height 13px
  color currentColor

.btn.context-delete-btn:hover
  background --bg-elevated
  border-color --accent-danger
  color --accent-danger

// Inspector Chapter & Title Controls
.node-chapter-select
  flex 1
  min-width 0

.node-chapter-input-wrap
  display flex
  align-items center
  border none
  border-bottom 1px solid --border-strong
  background transparent
  transition border-color 0.15s ease

.node-chapter-input-wrap:hover, .node-chapter-input-wrap:focus-within
  border-bottom-color --text-primary

.node-chapter-select.open .node-chapter-input-wrap
  border-bottom-color transparent

.node-inline-chapter
  flex 1
  min-width 0
  background transparent
  border none
  font-size 10px
  text-transform uppercase
  letter-spacing 1px
  color --text-muted
  font-family --font-sans
  padding 3px 0
  cursor text
  transition color 0.15s ease

.node-chapter-input-wrap:hover .node-inline-chapter, .node-inline-chapter:focus, .node-chapter-select.open .node-inline-chapter
  outline none
  color --text-primary

.node-chapter-caret-btn
  background transparent
  border none
  color --text-muted
  font-size 9px
  padding 3px 2px
  cursor pointer
  flex-shrink 0
  transition color 0.15s ease

.node-chapter-input-wrap:hover .node-chapter-caret-btn, .node-chapter-select.open .node-chapter-caret-btn
  color --text-primary

.node-icon-btn
  background transparent
  border none
  color --text-muted
  font-family --font-sans
  font-size 12px
  padding 2px 5px
  cursor pointer

.node-icon-btn:hover
  color --text-primary

.node-inline-title
  width 100%
  min-width 0
  background transparent
  border none
  border-bottom 1px solid transparent
  font-family --font-serif
  color --text-primary
  padding 2px 0
  transition border-color 0.15s ease

.editor-context-form .node-inline-title, .editor-chapter-form .node-inline-title, .editor-book-form .node-inline-title
  font-size 19px
  font-weight 400

.node-inline-title:hover
  border-bottom-color --border-strong

.node-inline-title:focus, .node-inline-title:active
  outline none
  border-bottom-color --text-primary

.node-title-row
  display flex
  align-items center
  gap 6px

.node-start-indicator
  display inline-flex
  align-items center
  justify-content center
  color --text-primary
  flex-shrink 0

.node-start-indicator.node-chapter-entry-indicator
  color --text-secondary

.node-add-choice-btn, .node-edit-text-btn
  align-self flex-start

// Node Metadata, Text Preview & Warnings
.node-meta-fields
  display flex
  flex-direction column
  gap 6px

.node-meta-row
  display flex
  align-items center
  gap 6px

.node-meta-row-textarea
  align-items flex-start

.node-meta-row-textarea .node-meta-key
  padding-top 4px

.node-meta-row-radio
  align-items flex-start

.node-meta-row-radio .node-meta-key
  padding-top 5px

.node-meta-textarea
  resize none !important
  overflow hidden !important
  overflow-y hidden !important
  scrollbar-width none !important
  min-height 24px
  line-height 1.45
  display block

.node-meta-key
  font-family --font-sans
  font-size 10px
  color --text-muted
  width 42px
  flex-shrink 0

.node-meta-input
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 11px
  padding 3px 0
  transition border-color 0.15s ease

.node-meta-input::placeholder
  color --text-muted
  font-weight 300
  opacity 1

.node-meta-input:hover
  border-bottom-color --border-strong

.node-meta-input:focus, .node-meta-input:active
  outline none
  border-bottom-color --text-primary

.node-text-preview
  width 100%
  background --bg-elevated
  border 1px solid --border-subtle
  padding 9px 11px
  color --text-secondary
  font-family --font-sans
  font-weight 300
  font-size 13px
  line-height 1.4
  text-align left
  cursor pointer
  display block
  overflow hidden
  transition border-color 0.15s ease, color 0.15s ease

.node-text-preview:hover
  border-color --border-strong
  color --text-primary

.node-text-snippet
  display block
  width 100%
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  pointer-events none

.node-warnings-list
  margin 0
  padding 6px 10px 6px 22px
  background --bg-elevated
  border 1px solid --accent-danger
  color --accent-danger
  font-family --font-sans
  font-size 10px
  line-height 1.45

// Custom Dropdowns (Media & Choice Targets)
.custom-select
  position relative
  min-width 0

.node-media-select
  flex 1

.node-choice-select
  width auto
  max-width none
  flex-shrink 0
  display inline-flex
  align-items center

.node-choice-select .custom-select-menu
  right 0
  left auto
  min-width 220px

.custom-select-trigger.choice-port-trigger
  width 28px
  height 28px
  padding 0
  border none
  background transparent
  display inline-flex
  align-items center
  justify-content center
  color --border-strong
  cursor pointer
  transition color 0.15s ease

.custom-select-trigger.choice-port-trigger:hover, .custom-select-trigger.choice-port-trigger:focus-visible, .custom-select.open .custom-select-trigger.choice-port-trigger
  border none
  color --text-primary

.choice-port-icon
  display block
  width 13px
  height 13px
  border-radius 50% !important
  border 2px solid currentColor
  background transparent
  pointer-events none
  transition background 0.15s ease, border-color 0.15s ease

.choice-port-icon.port-filled
  background currentColor

.book-setting-toggle-btn, .form-toggle-btn
  flex 1
  min-width 0
  width 100%
  display flex
  align-items center
  justify-content space-between
  gap 8px
  background transparent
  border none !important
  border-bottom none !important
  color --text-secondary
  font-family --font-sans
  font-size 11px
  padding 3px 0
  cursor pointer
  text-align left
  transition color 0.15s ease

.book-setting-toggle-btn:hover, .book-setting-toggle-btn.active, .form-toggle-btn:hover, .form-toggle-btn.active
  color --text-primary
  border none !important
  border-bottom none !important

.toggle-right
  display inline-flex
  align-items center
  gap 8px
  flex-shrink 0
  pointer-events none

.book-setting-toggle-btn .action-icon, .form-toggle-btn .action-icon
  width 13px
  height 13px
  color --text-muted
  flex-shrink 0
  pointer-events none

.book-setting-toggle-btn:hover .action-icon, .book-setting-toggle-btn.active .action-icon, .form-toggle-btn:hover .action-icon, .form-toggle-btn.active .action-icon
  color --text-primary

.toggle-switch
  width 22px
  height 10px
  border none
  background --toggle-track
  position relative
  flex-shrink 0
  display inline-flex
  align-items center
  padding 2px
  pointer-events none
  transition background 0.15s ease

.toggle-thumb
  width 6px
  height 6px
  border none
  background --toggle-thumb-off
  transform translateX(0)
  pointer-events none
  transition transform 0.15s ease, background 0.15s ease

.book-setting-toggle-btn:hover .toggle-thumb, .form-toggle-btn:hover .toggle-thumb
  background --text-secondary

.book-setting-toggle-btn.active .toggle-switch, .form-toggle-btn.active .toggle-switch
  background --toggle-track-on

.book-setting-toggle-btn.active .toggle-thumb, .form-toggle-btn.active .toggle-thumb
  background --text-primary
  transform translateX(12px)

// Minimalist Radio Group (Borderless Solid Squares, No Underlines)
.form-radio-group
  flex 1
  min-width 0
  display flex
  flex-direction column
  gap 2px

.form-radio-group.is-inline
  flex-direction row
  align-items center
  justify-content space-between
  gap 14px

.form-radio-option
  width 100%
  display flex
  align-items center
  justify-content space-between
  gap 8px
  padding 3px 0
  min-height 22px
  background transparent
  border none !important
  color --text-muted
  font-family --font-sans
  font-size 11px
  cursor pointer
  text-align left
  transition color 0.15s ease

.form-radio-group.is-inline .form-radio-option
  width auto
  justify-content flex-start
  gap 7px

.form-radio-input
  position absolute
  opacity 0
  width 0
  height 0
  pointer-events none

.form-radio-label
  flex 1
  min-width 0
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  pointer-events none

.form-radio-sq
  width 8px
  height 8px
  border none
  background --border-subtle
  flex-shrink 0
  pointer-events none
  transition background 0.15s ease

.form-radio-option:hover
  color --text-secondary

.form-radio-option:hover .form-radio-sq
  background --border-strong

.form-radio-option.active
  color --text-primary

.form-radio-option.active .form-radio-sq
  background --text-primary

.custom-select-trigger
  width 100%
  display flex
  align-items center
  justify-content space-between
  gap 6px
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 11px
  padding 3px 0
  cursor pointer
  text-align left
  transition border-color 0.15s ease, color 0.15s ease

.custom-select-trigger:hover
  border-bottom-color --border-strong

.custom-select-trigger:focus, .custom-select-trigger:active
  outline none
  border-bottom-color --text-primary

.custom-select.open .custom-select-trigger
  outline none
  border-bottom-color transparent

.custom-select-trigger:hover .custom-select-caret, .custom-select-trigger:focus .custom-select-caret, .custom-select.open .custom-select-trigger .custom-select-caret
  color --text-primary

.custom-select.open .custom-select-caret
  transform rotate(180deg)

.custom-select-label
  flex 1
  min-width 0
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  pointer-events none

.custom-select-caret
  width 13px
  height 13px
  font-size 9px
  color --text-muted
  flex-shrink 0
  pointer-events none
  transition transform 0.15s ease, color 0.15s ease

.custom-select-menu
  position absolute
  top 100%
  margin-top 0
  left 0
  right 0
  min-width 190px
  max-height 210px
  overflow-y auto
  background --bg-obsidian
  border-top 1px solid --text-primary
  border-left 1px solid --border-strong
  border-right 1px solid --border-strong
  border-bottom 1px solid --border-strong
  z-index 60
  display flex
  flex-direction column
  box-shadow 0 6px 16px rgba(0, 0, 0, 0.45)
  box-shadow switch(theme)
    light 0 2px 8px rgba(0, 0, 0, 0.05)

.custom-select-option
  width 100%
  background --bg-obsidian
  border none
  border-bottom 1px solid --border-subtle
  color --text-secondary
  font-family --font-sans
  font-size 10px
  padding 6px 8px
  text-align left
  cursor pointer
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  flex-shrink 0

.custom-select-option:last-child
  border-bottom none

.custom-select-option:hover, .custom-select-option.active
  background --bg-elevated
  color --text-primary

.custom-select-option.active
  font-weight 600

.node-micro-label
  font-size 9px
  text-transform uppercase
  letter-spacing 0.8px
  color --text-muted

.node-port-item .node-choice-label
  flex 1
  min-width 0
  background transparent
  border none
  color --text-secondary
  font-family --font-sans
  font-size 11px
  padding 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.node-choice-label
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 11px
  padding 3px 0

.node-choice-label:focus
  outline none
  border-bottom-color --text-primary

.node-choice-arrow
  font-family --font-sans
  font-size 11px
  color --text-muted
  flex-shrink 0

.node-choice-btn
  width 28px
  height 28px
  display inline-flex
  align-items center
  justify-content center
  padding 0
  font-size 12px
  flex-shrink 0

.node-choice-remove
  color --text-secondary
  transition color 0.15s ease

.node-choice-remove:hover
  color --accent-danger

.choice-trash-icon
  width 15px
  height 15px
  display block
  flex-shrink 0
  pointer-events none

.node-media-add-btn
  width 22px
  height 22px
  display inline-flex
  align-items center
  justify-content center
  padding 0
  font-size 13px
  flex-shrink 0
  background --bg-obsidian
  border 1px solid --border-strong
  color --text-primary

.node-media-add-btn:hover
  border-color --text-primary
  background --bg-elevated
  color --text-primary

.node-media-add-btn .media-plus-icon
  width 13px
  height 13px

body[data-ui-scale="large"]
  .node-media-add-btn .media-plus-icon
    width 15px
    height 15px
  .node-chapter-caret-btn
    font-size 12px
    padding 5px 8px

  .node-meta-input, .custom-select-trigger, .book-setting-toggle-btn, .form-toggle-btn, .form-radio-option
    font-size 12px
    padding 5px 0

  .custom-select-trigger.choice-port-trigger
    width 32px
    height 32px
    padding 0

  .choice-port-icon
    width 15px
    height 15px

  .custom-select-option
    font-size 12px
    padding 8px 10px

  .node-choice-btn
    width 32px
    height 32px
    font-size 15px

  .choice-trash-icon
    width 17px
    height 17px

  .node-media-add-btn
    width 28px
    height 28px
    font-size 15px
