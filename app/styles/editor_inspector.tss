@keyframes rightPanelSlideIn
  from
    transform translateX(100%)
  to
    transform translateX(0)

// Contextual Right Inspector Panel & Multi-Selection
.editor-context-panel
  order 3
  width 320px
  min-width 320px
  max-width 320px
  height 100%
  background --bg-obsidian
  border-left 1px solid --border-subtle
  overflow-y auto
  overflow-x hidden
  display flex
  flex-direction column
  flex-shrink 0
  z-index 35

.editor-context-panel:not(:has(> :not(.hidden)))
  display none

// Right-Side Breakdown, Variables, Version History & Help Panels
.editor-history-panel, .editor-help-panel
  order 3
  width 320px
  min-width 320px
  max-width 320px
  height 100%
  background --bg-obsidian
  border-left 1px solid --border-subtle
  overflow hidden
  display flex
  flex-direction column
  flex-shrink 0
  z-index 35

.help-panel-list
  display flex
  flex-direction column

.editor-breakdown-panel, .editor-variables-panel
  order 3
  width 320px
  min-width 320px
  max-width 320px
  height 100%
  background --bg-obsidian
  border-left 1px solid --border-subtle
  overflow-y auto
  overflow-x hidden
  display flex
  flex-direction column
  flex-shrink 0
  z-index 35

.editor-workspace-body > aside.is-entering
  will-change transform
  animation rightPanelSlideIn 0.2s cubic-bezier(0.22, 1, 0.36, 1)

/* @dev-only-start */
.device-stage[data-preview="portrait"]
  .editor-workspace-body > aside
    width 100%
    min-width 0
    max-width none
    flex 1
    border-left none

  .editor-workspace-body:has(> aside:not(.hidden)) .timeline-scroll-viewport
    display none !important
/* @dev-only-end */

@media (max-width: 760px) and (orientation: portrait)
  .editor-workspace-body > aside
    width 100%
    min-width 0
    max-width none
    flex 1
    border-left none

  .editor-workspace-body:has(> aside:not(.hidden)) .timeline-scroll-viewport
    display none !important

.node-meta-static-val
  flex 1
  font-family --font-sans
  font-size 12px
  color --text-primary
  padding 4px 0
  min-width 0
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.scene-text-delete-btn
  color --text-secondary
  display inline-flex
  align-items center
  gap 6px

.scene-text-delete-btn:hover
  color --accent-danger

.canvas-script-summary
  font-family --font-sans
  font-size 10px
  color --text-muted
  padding 2px 8px
  border-left 1px solid --border-subtle
  white-space nowrap
  overflow hidden
  text-overflow ellipsis

.editor-context-form
  display flex
  flex-direction column
  gap 12px
  padding 14px
  min-height 100%

.editor-chapter-form, .editor-book-form
  display flex
  flex-direction column
  gap 0
  padding 0
  min-height 100%

.editor-multi-panel
  display flex
  flex-direction column
  gap 12px
  padding 14px
  min-height 100%

.context-multi-scene-list
  display flex
  flex-direction column
  border-top 1px solid --border-subtle

.context-multi-scene-item
  display flex
  align-items center
  gap 4px
  background transparent
  border none
  border-bottom 1px solid --border-subtle
  padding 8px 0

.context-multi-scene-item:hover
  border-bottom-color --text-primary

.context-multi-scene-select-btn
  flex 1
  min-width 0
  display flex
  flex-direction column
  gap 2px
  background transparent
  border none
  padding 0
  text-align left
  cursor pointer
  color --text-primary
  font-family --font-sans

.context-multi-scene-title
  font-size 12px
  font-weight 400
  color --text-primary
  line-height 1.3
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.context-multi-scene-meta
  font-size 9px
  font-weight 400
  color --text-muted
  text-transform uppercase
  letter-spacing 0.5px
  line-height 1.2
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.context-multi-scene-deselect-btn
  flex-shrink 0

.context-panel-section
  display flex
  flex-direction column
  gap 5px

.context-choices-section
  display flex
  flex-direction column
  gap 8px

.context-choices-list
  display flex
  flex-direction column
  gap 8px

.context-choice-item
  display flex
  align-items center
  gap 6px
  padding 2px 0
  background transparent
  border none

.context-choice-item.is-dragging-choice
  background --bg-elevated

.choice-drag-grip
  display inline-flex
  align-items center
  justify-content center
  width 16px
  height 20px
  flex-shrink 0
  color --text-muted
  cursor grab
  user-select none

.choice-drag-grip:hover,
.is-dragging-choice .choice-drag-grip
  color --text-primary

.choice-grip-icon
  width 15px
  height 15px
  pointer-events none

.context-choice-item .node-choice-label
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  padding 3px 0

.context-choice-item .node-choice-label:focus
  border-bottom-color --text-primary

.context-danger-zone
  margin-top auto
  padding-top 14px
  border-top 1px solid --border-subtle
  display flex
  flex-direction column
  align-items flex-start

.btn.context-delete-btn
  align-self flex-start
  gap 6px
  color --accent-danger
  border-color --accent-danger
  background --bg-obsidian

.btn.context-delete-btn .btn-icon
  width 15px
  height 15px
  color currentColor

.btn.context-delete-btn:hover
  background --bg-elevated
  border-color --accent-danger
  color --accent-danger

// Inspector Chapter & Title Controls
.node-chapter-select
  flex 1
  min-width 0

.node-chapter-input-wrap
  display flex
  align-items center
  border none
  border-bottom 1px solid --border-strong
  background transparent
  transition border-color 0.15s ease

.node-chapter-input-wrap:hover, .node-chapter-input-wrap:focus-within
  border-bottom-color --text-primary

.node-chapter-select.open .node-chapter-input-wrap
  border-bottom-color transparent

.node-inline-chapter
  flex 1
  min-width 0
  background transparent
  border none
  font-size 10px
  text-transform uppercase
  letter-spacing 1px
  color --text-muted
  font-family --font-sans
  padding 3px 0
  cursor text
  transition color 0.15s ease

.node-chapter-input-wrap:hover .node-inline-chapter, .node-inline-chapter:focus, .node-chapter-select.open .node-inline-chapter
  outline none
  color --text-primary

.node-chapter-caret-btn
  background transparent
  border none
  color --text-muted
  font-size 9px
  padding 3px 2px
  cursor pointer
  flex-shrink 0
  transition color 0.15s ease

.node-chapter-input-wrap:hover .node-chapter-caret-btn, .node-chapter-select.open .node-chapter-caret-btn
  color --text-primary

.node-icon-btn
  background transparent
  border none
  color --text-muted
  font-family --font-sans
  font-size 12px
  padding 2px 5px
  cursor pointer

.node-icon-btn:hover
  color --text-primary

.node-inline-title
  width 100%
  min-width 0
  background transparent
  border none
  border-bottom 1px solid transparent
  font-family --font-serif
  color --text-primary
  padding 2px 0
  transition border-color 0.15s ease

.editor-context-form .node-inline-title, .editor-chapter-form .node-inline-title, .editor-book-form .node-inline-title
  font-size 19px
  font-weight 400

.node-inline-title:hover
  border-bottom-color --border-strong

.node-inline-title:focus, .node-inline-title:active
  outline none
  border-bottom-color --text-primary

.node-title-row
  display flex
  align-items center
  gap 6px

.node-start-indicator
  display inline-flex
  align-items center
  justify-content center
  color --text-primary
  flex-shrink 0

.node-start-indicator.node-chapter-entry-indicator
  color --text-secondary

.node-add-choice-btn, .node-edit-text-btn
  align-self flex-start

// Node Metadata, Text Preview & Warnings
.node-meta-fields
  display flex
  flex-direction column
  gap 6px

.node-meta-row
  display flex
  align-items center
  gap 6px

.node-meta-row-textarea
  align-items flex-start

.node-meta-row-textarea .node-meta-key
  padding-top 4px

.node-meta-row-radio
  align-items flex-start

.node-meta-row-radio .node-meta-key
  padding-top 5px

.node-meta-textarea
  resize none !important
  overflow hidden !important
  overflow-y hidden !important
  scrollbar-width none !important
  min-height 24px
  line-height 1.45
  display block

.node-meta-key
  font-family --font-sans
  font-size 12px
  line-height 1.4
  color --text-muted
  width 58px
  flex-shrink 0

.node-media-picker-row, .add-book-input-row
  flex 1
  min-width 0
  display flex
  align-items center
  gap 6px

.node-folder-btn
  width 28px
  height 28px
  padding 0
  display inline-flex
  align-items center
  justify-content center
  flex-shrink 0
  background transparent
  border none !important
  color --text-muted
  cursor pointer
  transition color 0.15s ease

.node-folder-btn:hover
  color --text-primary

.folder-browse-icon
  width 15px
  height 15px
  display block
  pointer-events none

.node-meta-input
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 12px
  line-height 1.4
  padding 3px 0
  transition border-color 0.15s ease

.node-meta-input::placeholder
  color --text-muted
  font-weight 300
  opacity 1

.node-meta-input:hover
  border-bottom-color --border-strong

.node-meta-input:focus, .node-meta-input:active
  outline none
  border-bottom-color --text-primary

.node-text-preview
  width 100%
  background transparent
  border none
  border-bottom 1px solid --border-subtle
  padding 8px 0
  color --text-secondary
  font-family --font-sans
  font-weight 300
  font-size 13px
  line-height 1.4
  text-align left
  cursor pointer
  display block
  overflow hidden
  transition border-color 0.15s ease, color 0.15s ease

.node-text-preview:hover
  border-bottom-color --border-strong
  color --text-primary

.node-text-snippet
  display block
  width 100%
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  pointer-events none

.node-warnings-list
  margin 0
  padding 6px 10px 6px 22px
  background --bg-elevated
  border 1px solid --accent-danger
  color --accent-danger
  font-family --font-sans
  font-size 10px
  line-height 1.45

// Custom Dropdowns (Media & Choice Targets)
.custom-select
  position relative
  min-width 0

.node-media-select
  flex 1

.node-choice-select
  width auto
  max-width none
  flex-shrink 0
  display inline-flex
  align-items center

.node-choice-select .custom-select-menu
  right 0
  left auto
  min-width 220px

.custom-select-trigger.choice-port-trigger
  width 28px
  height 28px
  padding 0
  border none
  background transparent
  display inline-flex
  align-items center
  justify-content center
  color --border-strong
  cursor pointer
  transition color 0.15s ease

.custom-select-trigger.choice-port-trigger:hover, .custom-select-trigger.choice-port-trigger:focus-visible, .custom-select.open .custom-select-trigger.choice-port-trigger
  border none
  color --text-primary

.choice-port-icon
  display block
  width 13px
  height 13px
  border-radius 50% !important
  border 2px solid currentColor
  background transparent
  pointer-events none
  transition background 0.15s ease, border-color 0.15s ease

.choice-port-icon.port-filled
  background currentColor

.choice-port-icon.port-diamond
  width 10px
  height 10px
  border-radius 0 !important
  transform rotate(45deg)

// Minimalist Radio Group (Borderless Solid Squares, No Underlines)
.form-radio-group
  flex 1
  min-width 0
  display flex
  flex-direction column
  gap 2px

.form-radio-group.is-inline
  flex-direction row
  align-items center
  justify-content space-between
  gap 14px

.form-radio-option
  width 100%
  display flex
  align-items center
  justify-content space-between
  gap 8px
  padding 3px 0
  min-height 22px
  background transparent
  border none !important
  color --text-muted
  font-family --font-sans
  font-size 12px
  line-height 1.4
  cursor pointer
  text-align left
  transition color 0.15s ease

.form-radio-group.is-inline .form-radio-option
  width auto
  justify-content flex-start
  gap 7px

.form-radio-input
  position absolute
  opacity 0
  width 0
  height 0
  pointer-events none

.form-radio-label
  flex 1
  min-width 0
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  pointer-events none

.form-radio-sq
  width 8px
  height 8px
  border none
  background --border-subtle
  flex-shrink 0
  pointer-events none
  transition background 0.15s ease

.form-radio-option:hover
  color --text-secondary

.form-radio-option:hover .form-radio-sq
  background --border-strong

.form-radio-option.active
  color --text-primary

.form-radio-option.active .form-radio-sq
  background --text-primary

.custom-select-trigger
  width 100%
  display flex
  align-items center
  justify-content space-between
  gap 6px
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 12px
  line-height 1.4
  padding 3px 0
  cursor pointer
  text-align left
  transition border-color 0.15s ease, color 0.15s ease

.custom-select-trigger:hover
  border-bottom-color --border-strong

.custom-select-trigger:focus, .custom-select-trigger:active
  outline none
  border-bottom-color --text-primary

.custom-select.open .custom-select-trigger
  outline none
  border-bottom-color transparent

.custom-select-trigger:hover .custom-select-caret, .custom-select-trigger:focus .custom-select-caret, .custom-select.open .custom-select-trigger .custom-select-caret
  color --text-primary

.custom-select.open .custom-select-caret
  transform rotate(180deg)

.custom-select-label
  flex 1
  min-width 0
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  pointer-events none

.custom-select-caret
  width 13px
  height 13px
  font-size 9px
  color --text-muted
  flex-shrink 0
  pointer-events none
  transition transform 0.15s ease, color 0.15s ease

.custom-select-menu
  position absolute
  top 100%
  margin-top 0
  left 0
  right 0
  min-width 190px
  max-height 210px
  overflow-y auto
  background --dropdown-bg
  border-top 1px solid --text-primary
  border-left 1px solid --dropdown-border
  border-right 1px solid --dropdown-border
  border-bottom 1px solid --dropdown-border
  z-index 60
  display flex
  flex-direction column
  box-shadow 0 6px 16px rgba(0, 0, 0, 0.45)
  box-shadow switch(theme)
    light 0 2px 8px rgba(0, 0, 0, 0.05)

.custom-select-option
  width 100%
  background transparent
  border none
  color --dropdown-item-fg
  font-family --font-sans
  font-size 12px
  padding 6px 8px
  text-align left
  cursor pointer
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  flex-shrink 0

.custom-select-option:hover, .custom-select-option.active
  background --dropdown-hover-bg
  color --text-primary

.custom-select-option.active
  font-weight 600

.choice-inline-wrap
  position relative
  flex 1
  min-width 0
  height 100%
  display flex
  align-items center

.choice-inline-wrap:has(> .syn-autocomplete-dropdown:not(.hidden))
  z-index 85

.choice-inline-hl
  position absolute
  inset 0
  display flex
  align-items center
  white-space pre
  overflow hidden
  pointer-events none
  user-select none
  font-family --font-sans
  font-size 11px
  line-height 1.4
  padding 3px 0

.choice-triple-row .choice-inline-hl
  font-size 12px
  padding 0

.choice-hl-label
  color --text-primary

.choice-hl-arrow
  color --text-muted
  font-family --font-mono

.choice-inline-wrap > input.node-choice-label, .choice-inline-wrap > input.choice-label-text
  position relative
  z-index 1
  width 100%
  color transparent !important
  caret-color --text-primary

.choice-inline-wrap > input.node-choice-label::selection, .choice-inline-wrap > input.choice-label-text::selection
  background rgba(128, 128, 140, 0.28)
  color transparent !important

.node-micro-label
  font-size 9px
  text-transform uppercase
  letter-spacing 0.8px
  color --text-muted

.node-port-item .node-choice-label
  flex 1
  min-width 0
  background transparent
  border none
  color --text-secondary
  font-family --font-sans
  font-size 11px
  padding 0
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.node-choice-label
  flex 1
  min-width 0
  background transparent
  border none
  border-bottom 1px solid --border-strong
  color --text-primary
  font-family --font-sans
  font-size 11px
  padding 3px 0

.node-choice-label:focus
  outline none
  border-bottom-color --text-primary

.node-choice-arrow
  font-family --font-sans
  font-size 11px
  color --text-muted
  flex-shrink 0

.node-choice-btn
  width 28px
  height 28px
  display inline-flex
  align-items center
  justify-content center
  padding 0
  font-size 12px
  flex-shrink 0

.node-choice-remove
  color --text-secondary
  transition color 0.15s ease

.node-choice-remove:hover
  color --accent-danger

.choice-trash-icon
  width 15px
  height 15px
  display block
  flex-shrink 0
  pointer-events none

.node-media-add-btn
  width 28px
  height 28px
  display inline-flex
  align-items center
  justify-content center
  padding 0
  font-size 13px
  flex-shrink 0
  background --bg-obsidian
  border 1px solid --border-strong
  color --text-primary

.node-media-add-btn:hover
  border-color --text-primary
  background --bg-elevated
  color --text-primary

.node-media-add-btn .media-plus-icon
  width 15px
  height 15px

.node-media-add-btn.voice-rec-toggle-btn
  position relative
  border none !important
  background transparent !important
  width 24px
  height 24px
  color --text-secondary

.node-media-add-btn.voice-rec-toggle-btn:hover,
.node-media-add-btn.voice-rec-toggle-btn.active
  color --text-primary
  background transparent !important

.voice-rec-strip
  display flex
  align-items center
  gap 8px
  width 100%
  min-height 28px
  padding 6px 0 2px 0
  user-select none

.voice-rec-strip.modal-voice-rec-strip
  padding 12px 0 6px 0
  gap 10px

.voice-rec-transport-btn,
.voice-rec-action-btn
  width 20px
  height 20px
  display inline-flex
  align-items center
  justify-content center
  padding 0
  border none
  background transparent
  color --text-secondary
  cursor pointer
  flex-shrink 0

.voice-rec-transport-btn
  color --text-primary

.voice-rec-transport-btn:hover,
.voice-rec-action-btn:hover
  color --text-primary

.voice-rec-action-btn:disabled,
.voice-rec-action-btn.is-disabled
  opacity 0.28
  color --text-muted
  cursor default
  pointer-events none

.voice-rec-icon,
.voice-rec-btn-icon
  width 15px
  height 15px
  display block
  pointer-events none

.voice-rec-waveform-wrap
  position relative
  flex 1
  min-width 0
  height 28px
  display flex
  align-items center
  cursor pointer
  touch-action none

.modal-voice-rec-strip .voice-rec-waveform-wrap
  height 30px

.voice-rec-waveform-canvas
  width 100%
  height 100%
  display block
  pointer-events none

.voice-rec-playhead
  position absolute
  top 0
  bottom 0
  left 0%
  width 1px
  background --text-primary
  pointer-events none
  z-index 1

.voice-rec-trim-handle
  position absolute
  top 0
  bottom 0
  width 10px
  cursor ew-resize
  z-index 2
  touch-action none

.voice-rec-trim-handle::before,
.voice-rec-trim-handle::after
  content ""
  position absolute
  width 6px
  height 6px
  pointer-events none

.voice-rec-trim-handle.trim-start
  left 0%

.voice-rec-trim-handle.trim-start::before
  top 0
  left 0
  border-top 1px solid --text-primary
  border-left 1px solid --text-primary

.voice-rec-trim-handle.trim-start::after
  bottom 0
  left 0
  border-bottom 1px solid --text-primary
  border-left 1px solid --text-primary

.voice-rec-trim-handle.trim-end
  left 100%
  transform translateX(-100%)

.voice-rec-trim-handle.trim-end::before
  top 0
  right 0
  border-top 1px solid --text-primary
  border-right 1px solid --text-primary

.voice-rec-trim-handle.trim-end::after
  bottom 0
  right 0
  border-bottom 1px solid --text-primary
  border-right 1px solid --text-primary

.voice-rec-strip.is-recording .voice-rec-trim-handle,
[data-voice-strip][data-voice-state="recording"] .voice-rec-trim-handle
  display none

[data-voice-strip][data-voice-state="recording"] [data-voice-icon="stop"],
[data-voice-strip][data-voice-state="playing"] [data-voice-icon="pause"],
[data-voice-strip][data-voice-state="ready"] [data-voice-icon="play"],
[data-voice-strip][data-voice-state="idle"] [data-voice-icon="mic"]
  display block !important

[data-voice-strip][data-voice-state="recording"] [data-voice-icon="mic"],
[data-voice-strip][data-voice-state="recording"] [data-voice-icon="play"],
[data-voice-strip][data-voice-state="recording"] [data-voice-icon="pause"],
[data-voice-strip][data-voice-state="playing"] [data-voice-icon="play"]
  display none !important

[data-voice-strip][data-voice-state="playing"] [data-voice-icon="mic"],
[data-voice-strip][data-voice-state="playing"] [data-voice-icon="stop"],
[data-voice-strip][data-voice-state="ready"] [data-voice-icon="pause"],
[data-voice-strip][data-voice-state="ready"] [data-voice-icon="mic"]
  display none !important

[data-voice-strip][data-voice-state="ready"] [data-voice-icon="stop"],
[data-voice-strip][data-voice-state="idle"] [data-voice-icon="play"],
[data-voice-strip][data-voice-state="idle"] [data-voice-icon="pause"],
[data-voice-strip][data-voice-state="idle"] [data-voice-icon="stop"]
  display none !important

[data-voice-strip][data-voice-state="recording"] [data-voice-record-start="true"],
[data-voice-strip][data-voice-state="recording"] [data-voice-delete="true"],
[data-voice-strip][data-voice-state="idle"] [data-voice-record-start="true"],
[data-voice-strip][data-voice-state="idle"] [data-voice-delete="true"]
  display none !important

[data-voice-strip][data-voice-state="ready"] [data-voice-record-start="true"],
[data-voice-strip][data-voice-state="ready"] [data-voice-delete="true"],
[data-voice-strip][data-voice-state="playing"] [data-voice-record-start="true"],
[data-voice-strip][data-voice-state="playing"] [data-voice-delete="true"]
  display inline-flex !important

.voice-rec-timer
  font-family --font-sans
  font-size 10px
  font-weight 400
  color --text-secondary
  min-width 26px
  text-align right
  flex-shrink 0
  font-variant-numeric tabular-nums

.voice-rec-strip.is-recording .voice-rec-timer,
[data-voice-strip][data-voice-state="recording"] .voice-rec-timer
  color --text-primary
  font-weight 700

.voice-rec-sections
  display flex
  align-items center
  justify-content space-between
  gap 12px
  border-bottom 1px solid --border-subtle
  margin-top 4px
  margin-bottom 2px

.inspector-voice-rec-sections
  margin-top 2px
  margin-bottom 6px

.voice-rec-sections-tabs
  display flex
  align-items center
  gap 14px
  flex-wrap wrap
  min-width 0

.inspector-voice-rec-sections .voice-rec-sections-tabs
  gap 10px

.voice-rec-section-btn
  display inline-flex
  align-items center
  gap 5px
  background transparent
  border none
  border-bottom 1px solid transparent
  margin-bottom -1px
  padding 4px 0 6px 0
  cursor pointer
  color --text-muted
  font-family --font-sans
  font-size 10px
  font-weight 400
  letter-spacing 0.8px
  transition color 0.15s ease, border-color 0.15s ease

.voice-rec-section-btn:hover
  color --text-secondary

.voice-rec-section-btn.active
  color --text-primary
  font-weight 700
  border-bottom-color --text-primary

.voice-rec-section-dot
  width 6px
  height 6px
  border 1px solid --border-strong
  background transparent
  flex-shrink 0
  pointer-events none

.inspector-voice-rec-sections .voice-rec-section-dot
  width 5px
  height 5px

.voice-rec-section-dot.is-recorded
  background --text-primary
  border-color --text-primary

.voice-rec-section-label
  pointer-events none
  white-space nowrap

.voice-rec-section-time
  font-size 9px
  color --text-secondary
  font-weight 400
  margin-left 2px
  font-variant-numeric tabular-nums
  pointer-events none

.voice-rec-section-btn.active .voice-rec-section-time
  color --text-primary

.voice-rec-section-file
  font-family --font-sans
  font-size 10px
  color --text-muted
  white-space nowrap
  overflow hidden
  text-overflow ellipsis
  flex-shrink 0

.voice-section-isolation-bar
  display flex
  align-items center
  justify-content space-between
  padding 0 0 10px 0
  font-family --font-sans
  font-size 10px
  font-weight 700
  letter-spacing 1.2px
  color --text-secondary

.voice-section-isolation-title
  color --text-secondary

body[data-ui-scale="large"]
  .history-panel-header
    height 42px
    min-height 42px
    max-height 42px

  .var-name-input
    width 118px
    flex 0 0 118px
    font-size 13px

  .var-val-input, .syn-inner-input, .syn-brace, .choice-row-key
    font-size 13px

  .var-panel-inline-form:has(+ .var-bool-toggle-btn)
    flex 0 0 118px
    width 118px

  .var-bool-toggle-btn
    font-size 13px
    padding 5px 0

  .ui-toggle-track, .toggle-switch
    width 26px
    height 12px

  .ui-toggle-thumb, .toggle-thumb
    width 8px
    height 8px

  .var-bool-toggle-btn.active .ui-toggle-thumb, .test-var-bool-btn.active .ui-toggle-thumb, .book-setting-toggle-btn.active .toggle-thumb, .form-toggle-btn.active .toggle-thumb
    transform translateX(14px)

  .node-media-add-btn .media-plus-icon, .folder-browse-icon, .choice-grip-icon, .book-setting-toggle-btn .action-icon
    width 18px
    height 18px
  .var-remove-btn, .node-folder-btn
    width 32px
    height 32px
  .node-chapter-caret-btn
    font-size 12px
    padding 5px 8px

  .node-meta-key
    font-size 13px
    width 64px

  .node-meta-input, .custom-select-trigger, .book-setting-toggle-btn, .form-radio-option
    font-size 13px
    padding 5px 0

  .custom-select-trigger.choice-port-trigger
    width 32px
    height 32px
    padding 0

  .choice-port-icon
    width 15px
    height 15px

  .custom-select-option
    font-size 13px
    padding 8px 10px

  .node-choice-btn
    width 32px
    height 32px
    font-size 15px

  .choice-trash-icon
    width 18px
    height 18px

  .node-media-add-btn
    width 32px
    height 32px
    font-size 15px
